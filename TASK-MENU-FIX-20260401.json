  "detailed_steps": [
    {
      "step": 1,
      "action": "确定当前使用的app.js文件",
      "command": "cd /usr/share/nginx/html/bio && ls -la js/app.*.js && grep -o 'app\\.[a-f0-9]*\\.js' index.html"
    },
    {
      "step": 2,
      "action": "备份当前文件",
      "command": "CURRENT_APP=\"找到的实际文件名\" && cp js/$CURRENT_APP js/$CURRENT_APP.backup.$(date +%Y%m%d_%H%M%S)"
    },
    {
      "step": 3,
      "action": "修复菜单项",
      "command": "perl -i -pe 's/\"生产信息\"/\"生产信息\",\"产品信息\",\"客户信息\"/' js/$CURRENT_APP"
    },
    {
      "step": 4,
      "action": "验证修复",
      "command": "grep -o '\\\"产品信息\\\"' js/$CURRENT_APP && grep -o '\\\"客户信息\\\"' js/$CURRENT_APP"
    },
    {
      "step": 5,
      "action": "重启Nginx并测试",
      "command": "systemctl restart nginx && systemctl status nginx"
    }
  ],
