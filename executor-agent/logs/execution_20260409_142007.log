// 医疗器械产品管理组件 - 替换主应用中的空白组件
// 这个组件将被动态加载到 /product 路由

export default {
  name: 'ProductList',
  template: `
    <div class="product-management">
      <div class="page-header">
        <h2>🏥 医疗器械产品信息管理</h2>
        <p>管理医疗器械产品信息、库存、价格及资质证件</p>
      </div>
      
      <div class="action-bar">
        <el-button type="primary" @click="handleAdd">
          <i class="el-icon-plus"></i> 新增产品
        </el-button>
        <el-button @click="refreshData">
          <i class="el-icon-refresh"></i> 刷新
        </el-button>
        <el-input
          v-model="searchKeyword"
          placeholder="搜索产品名称、型号、注册证号..."
          style="width: 300px; margin-left: 20px;"
          @input="handleSearch"
        >
          <template #prefix>
            <i class="el-icon-search"></i>
          </template>
        </el-input>
      </div>
      
      <!-- 统计卡片 -->
      <div class="stats-cards">
        <el-card class="stat-card">
          <div class="stat-content">
            <div class="stat-label">总产品数</div>
            <div class="stat-value">{{ totalProducts }}</div>
          </div>
        </el-card>
        <el-card class="stat-card">
          <div class="stat-content">
            <div class="stat-label">库存充足</div>
            <div class="stat-value" style="color: #67c23a;">{{ instockProducts }}</div>
          </div>
        </el-card>
        <el-card class="stat-card">
          <div class="stat-content">
            <div class="stat-label">库存预警</div>
            <div class="stat-value" style="color: #e6a23c;">{{ lowstockProducts }}</div>
          </div>
        </el-card>
        <el-card class="stat-card">
          <div class="stat-content">
            <div class="stat-label">缺货产品</div>
            <div class="stat-value" style="color: #f56c6c;">{{ outstockProducts }}</div>
          </div>
        </el-card>
      </div>
      
      <!-- 产品表格 -->
      <el-card class="table-card">
        <el-table :data="filteredProducts" style="width: 100%" v-loading="loading">
          <el-table-column prop="productCode" label="产品编码" width="120" />
          <el-table-column prop="productName" label="产品名称" min-width="180" />
          <el-table-column prop="productModel" label="型号" width="100" />
          <el-table-column prop="medicalLicense" label="注册证号" width="180" />
          <el-table-column prop="stockQuantity" label="库存数量" width="120">
            <template #default="scope">
              {{ scope.row.stockQuantity || 0 }} {{ scope.row.unit || '' }}
            </template>
          </el-table-column>
          <el-table-column label="库存状态" width="100">
            <template #default="scope">
              <el-tag :type="getStockStatusType(scope.row.stockQuantity, scope.row.minStock)" size="small">
                {{ getStockStatusText(scope.row.stockQuantity, scope.row.minStock) }}
              </el-tag>
            </template>
          </el-table-column>
          <el-table-column label="销售单价" width="100">
            <template #default="scope">
              ¥{{ scope.row.salePrice ? scope.row.salePrice.toFixed(2) : '0.00' }}
            </template>
          </el-table-column>
          <el-table-column label="操作" width="150" fixed="right">
            <template #default="scope">
              <el-button type="text" size="small" @click="handleEdit(scope.row)">编辑</el-button>
              <el-button type="text" size="small" @click="handleDelete(scope.row)" style="color: #f56c6c;">删除</el-button>
            </template>
          </el-table-column>
        </el-table>
        
        <div v-if="filteredProducts.length === 0 && !loading" class="empty-state">
          <i class="el-icon-document" style="font-size: 48px; color: #909399;"></i>
          <p>暂无产品数据，点击"新增产品"开始添加</p>
        </div>
      </el-card>
    </div>
  `,
  
  data() {
    return {
      products: [],
      searchKeyword: '',
      loading: false
    };
  },
  
  computed: {
    totalProducts() {
      return this.products.length;
    },
    
    instockProducts() {
      return this.products.filter(p => this.getStockStatus(p.stockQuantity, p.minStock) === 'instock').length;
    },
    
    lowstockProducts() {
      return this.products.filter(p => this.getStockStatus(p.stockQuantity, p.minStock) === 'lowstock').length;
    },
    
    outstockProducts() {
      return this.products.filter(p => this.getStockStatus(p.stockQuantity, p.minStock) === 'outstock').length;
    },
    
    filteredProducts() {
      if (!this.searchKeyword) return this.products;
      const keyword = this.searchKeyword.toLowerCase();
      return this.products.filter(product => 
        (product.productName && product.productName.toLowerCase().includes(keyword)) ||
        (product.productCode && product.productCode.toLowerCase().includes(keyword)) ||
        (product.productModel && product.productModel.toLowerCase().includes(keyword)) ||
        (product.medicalLicense && product.medicalLicense.toLowerCase().includes(keyword)) ||
        (product.supplier && product.supplier.toLowerCase().includes(keyword))
      );
    }
  },
  
  mounted() {
    this.loadProducts();
  },
  
  methods: {
    async loadProducts() {
      this.loading = true;
      try {
        // 尝试从现有API加载数据
        const response = await fetch('/api/products');
        if (response.ok) {
          this.products = await response.json();
        } else {
          // 如果API失败，使用示例数据
          this.products = this.getSampleData();
        }
      } catch (error) {
        console.error('加载产品数据失败:', error);
        this.products = this.getSampleData();
      } finally {
        this.loading = false;
      }
    },
    
    getSampleData() {
      return [
        {
          id: 1,
          productCode: 'PROD2026001',
          productName: '一次性使用无菌注射器',
          productModel: '5ml',
          medicalLicense: '国械注准20213456789',
          stockQuantity: 150,
          unit: '支',
          minStock: 50,
          salePrice: 2.50,
          storageCondition: '常温干燥',
          supplier: '江苏医疗器械有限公司'
        },
        {
          id: 2,
          productCode: 'PROD2026002',
          productName: '医用外科口罩',
          productModel: '三层',
          medicalLicense: '国械注准20212345678',
          stockQuantity: 25,
          unit: '盒',
          minStock: 30,
          salePrice: 15.00,
          storageCondition: '常温',
          supplier: '上海医疗用品厂'
        },
        {
          id: 3,
          productCode: 'PROD2026003',
          productName: '电子体温计',
          productModel: 'DT-01',
          medicalLicense: '国械注准20211234567',
          stockQuantity: 0,
          unit: '个',
          minStock: 10,
          salePrice: 89.00,
          storageCondition: '常温防潮',
          supplier: '广东医疗设备公司'
        }
      ];
    },
    
    getStockStatus(quantity, minStock) {
      if (quantity === 0) return 'outstock';
      if (quantity < minStock) return 'lowstock';
      return 'instock';
    },
    
    getStockStatusText(quantity, minStock) {
      const status = this.getStockStatus(quantity, minStock);
      switch(status) {
        case 'instock': return '库存充足';
        case 'lowstock': return '库存预警';
        case 'outstock': return '缺货';
        default: return '未知';
      }
    },
    
    getStockStatusType(quantity, minStock) {
      const status = this.getStockStatus(quantity, minStock);
      switch(status) {
        case 'instock': return 'success';
        case 'lowstock': return 'warning';
        case 'outstock': return 'danger';
        default: return 'info';
      }
    },
    
    handleAdd() {
      this..info('新增产品功能 - 将在完整版本中实现');
    },
    
    handleEdit(product) {
      this..info(`编辑产品: ${product.productName} - 将在完整版本中实现`);
    },
    
    handleDelete(product) {
      this.(`确定要删除产品 ${product.productName} 吗？`, '提示', {
        confirmButtonText: '确定',
        cancelButtonText: '取消',
        type: 'warning'
      }).then(() => {
        this.products = this.products.filter(p => p.id !== product.id);
        this..success('产品删除成功');
      }).catch(() => {
        // 用户取消删除
      });
    },
    
    handleSearch() {
      // 搜索功能通过computed属性自动处理
    },
    
    refreshData() {
      this.loadProducts();
      this..success('数据已刷新');
    }
  }
};
