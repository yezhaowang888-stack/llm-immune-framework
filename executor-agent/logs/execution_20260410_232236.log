ndex=\"/purchase/list\">采购单列表</el-menu-item>\r\n          <el-menu-item index=\"/purchase/add\">新建采购</el-menu-item>\r\n          <el-menu-item index=\"/purchase/scan\">扫码入库</el-menu-item>\r\n        </el-sub-menu>\r\n        \r\n        <el-sub-menu index=\"after-sales\">\r\n          <template #title>\r\n            <el-icon><Tools /></el-icon>\r\n            <span>售后维修</span>\r\n          </template>\r\n          <el-menu-item index=\"/after-sales/list\">工单列表</el-menu-item>\r\n          <el-menu-item index=\"/after-sales/add\">新建工单</el-menu-item>\r\n        </el-sub-menu>\r\n        \r\n        <el-sub-menu index=\"inventory\">\r\n          <template #title>\r\n            <el-icon><Files /></el-icon>\r\n            <span>库存管理</span>\r\n          </template>\r\n          <el-menu-item index=\"/inventory/list\">库存列表</el-menu-item>\r\n          <el-menu-item index=\"/inventory/check\">库存盘点</el-menu-item>\r\n        </el-sub-menu>\r\n        \r\n        <el-menu-item index=\"/report\">\r\n          <el-icon><DataLine /></el-icon>\r\n          <span>报表分析</span>\r\n        </el-menu-item>\r\n        \r\n        <el-menu-item index=\"/system\">\r\n          <el-icon><Setting /></el-icon>\r\n          <span>系统设置</span>\r\n        </el-menu-item>\r\n      </el-menu>\r\n      \r\n      <div class=\"collapse-btn\" @click=\"toggleSidebar\">\r\n        <el-icon>\r\n          <component :is=\"isCollapsed ? 'Expand' : 'Fold'\" />\r\n        </el-icon>\r\n      </div>\r\n    </div>\r\n    \r\n    <!-- 主内容区 -->\r\n    <div class=\"main-container\" :class=\"{ collapsed: isCollapsed }\">\r\n      <!-- 顶部导航 -->\r\n      <div class=\"header\">\r\n        <div class=\"header-left\">\r\n          <el-breadcrumb separator=\"/\">\r\n            <el-breadcrumb-item :to=\"{ path: '/dashboard' }\">首页</el-breadcrumb-item>\r\n            <el-breadcrumb-item>{{ currentRoute }}</el-breadcrumb-item>\r\n          </el-breadcrumb>\r\n        </div>\r\n        \r\n        <div class=\"header-right\">\r\n          <el-badge :value=\"3\" class=\"notification-badge\">\r\n            <el-icon size=\"20\"><Bell /></el-icon>\r\n          </el-badge>\r\n          \r\n          <el-dropdown @command=\"handleCommand\">\r\n            <div class=\"user-info\">\r\n              <el-avatar :size=\"32\" src=\"https://cube.elemecdn.com/3/7c/3ea6beec64369c2642b92c6726f1epng.png\" />\r\n              <span class=\"username\">管理员</span>\r\n            </div>\r\n            <template #dropdown>\r\n              <el-dropdown-menu>\r\n                <el-dropdown-item command=\"profile\">个人资料</el-dropdown-item>\r\n                <el-dropdown-item command=\"password\">修改密码</el-dropdown-item>\r\n                <el-dropdown-item divided command=\"logout\">退出登录</el-dropdown-item>\r\n              </el-dropdown-menu>\r\n            </template>\r\n          </el-dropdown>\r\n        </div>\r\n      </div>\r\n      \r\n      <!-- 内容区 -->\r\n      <div class=\"content\">\r\n        <router-view />\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script setup>\r\nimport { ref, computed } from 'vue'\r\nimport { useRoute, useRouter } from 'vue-router'\r\nimport { ElMessage } from 'element-plus'\r\nimport {\r\n  Odometer, Monitor, ShoppingCart, Box, Tools,\r\n  Files, DataLine, Setting, Bell, Expand, Fold\r\n} from '@element-plus/icons-vue'\r\n\r\nconst route = useRoute()\r\nconst router = useRouter()\r\nconst isCollapsed = ref(false)\r\n\r\nconst activeMenu = computed(() => route.path)\r\n\r\nconst currentRoute = computed(() => {\r\n  const matched = route.matched[route.matched.length - 1]\r\n  return matched?.meta?.title || route.name || ''\r\n})\r\n\r\nconst toggleSidebar = () => {\r\n  isCollapsed.value = !isCollapsed.value\r\n}\r\n\r\nconst handleCommand = (command) => {\r\n  if (command === 'logout') {\r\n    ElMessage.success('退出登录')\r\n    router.push('/')\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.app-wrapper {\r\n  height: 100vh;\r\n  display: flex;\r\n  overflow: hidden;\r\n}\r\n\r\n.sidebar {\r\n  width: 210px;\r\n  height: 100vh;\r\n  background: #304156;\r\n  color: white;\r\n  transition: width 0.3s;\r\n  display: flex;\r\n  flex-direction: column;\r\n  position: relative;\r\n}\r\n\r\n.sidebar.collapsed {\r\n  width: 64px;\r\n}\r\n\r\n.logo-container {\r\n  height: 60px;\r\n  display: flex;\r\n  align-items: center;\r\n  padding: 0 16px;\r\n  background: #2b3649;\r\n  overflow: hidden;\r\n}\r\n\r\n.logo {\r\n  width: 32px;\r\n  height: 32px;\r\n  margin-right: 8px;\r\n}\r\n\r\n.logo-text {\r\n  color: white;\r\n  font-size: 16px;\r\n  font-weight: 600;\r\n  white-space: nowrap;\r\n}\r\n\r\n.sidebar-menu {\r\n  flex: 1;\r\n  border-right: none;\r\n  background: transparent;\r\n}\r\n\r\n.sidebar-menu :deep(.el-menu-item),\r\n.sidebar-menu :deep(.el-sub-menu__title) {\r\n  color: #bfcbd9;\r\n  background: transparent !important;\r\n}\r\n\r\n.sidebar-menu :deep(.el-menu-item:hover),\r\n.sidebar-menu :deep(.el-sub-menu__title:hover) {\r\n  color: white;\r\n  background: #263445 !important;\r\n}\r\n\r\n.sidebar-menu :deep(.el-menu-item.is-active) {\r\n  color: #409EFF;\r\n  background: #263445 !important;\r\n}\r\n\r\n.sidebar-menu :deep(.el-menu-item .el-icon),\r\n.sidebar-menu :deep(.el-sub-menu__title .el-icon) {\r\n  color: inherit;\r\n}\r\n\r\n.collapse-btn {\r\n  height: 40px;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  color: #bfcbd9;\r\n  cursor: pointer;\r\n  border-top: 1px solid #40516b;\r\n}\r\n\r\n.collapse-btn:hover {\r\n  color: white;\r\n  background: #263445;\r\n}\r\n\r\n.main-container {\r\n  flex: 1;\r\n  display: flex;\r\n  flex-direction: column;\r\n  overflow: hidden;\r\n  transition: margin-left 0.3s;\r\n  background: #f0f2f5;\r\n}\r\n\r\n.header {\r\n  height: 60px;\r\n  background: white;\r\n  border-bottom: 1px solid #e4e7ed;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  padding: 0 20px;\r\n  box-shadow: 0 1px 4px 