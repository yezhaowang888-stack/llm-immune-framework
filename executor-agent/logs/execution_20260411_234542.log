console.log('🔧 动态路由注册系统启动（等待Vue Router版）');

// 等待 Vue Router 初始化完成
(function waitForRouter() {
    // 检查各种可能的 Vue Router 实例
    if (window. || window.__VUE_ROUTER__) {
        console.log('✅ Vue Router 已检测到，开始注册动态路由');
        registerDynamicRoutes();
    } else if (window.vueApp && window.vueApp.) {
        console.log('✅ Vue Router 已检测到（通过 vueApp），开始注册动态路由');
        registerDynamicRoutes(window.vueApp.);
    } else if (window.Vue && window.Vue.prototype.) {
        console.log('✅ Vue Router 已检测到（通过 Vue 全局），开始注册动态路由');
        registerDynamicRoutes(window.Vue.prototype.);
    } else {
        console.log('⏳ 等待 Vue Router 初始化...');
        setTimeout(waitForRouter, 100);
    }
})();

function registerDynamicRoutes(routerInstance) {
    const router = routerInstance || window. || window.__VUE_ROUTER__;
    if (!router) {
        console.error('❌ 无法获取 Vue Router 实例');
        return;
    }
    
    console.log('🔧 开始注册动态路由...');
    
    // 添加客户管理路由
    try {
        router.addRoute({
            path: '/customer',
            name: 'Customer',
            component: {
                template: '<div><h2>客户信息管理</h2><p>客户信息管理页面</p></div>'
            },
            meta: { title: '客户信息', icon: 'el-icon-user' }
        });
        console.log('✅ 客户管理路由注册完成');
    } catch (error) {
        console.error('❌ 客户管理路由注册失败:', error);
    }
    
    // 添加产品管理路由
    try {
        router.addRoute({
            path: '/product',
            name: 'Product',
            component: {
                template: '<div><h2>产品信息管理</h2><p>产品信息管理页面</p></div>'
            },
            meta: { title: '产品信息', icon: 'el-icon-goods' }
        });
        console.log('✅ 产品管理路由注册完成');
    } catch (error) {
        console.error('❌ 产品管理路由注册失败:', error);
    }
    
    console.log('✅ 动态路由注册完成');
    
    // 触发路由更新
    if (router.currentRoute) {
        router.currentRoute._value = router.currentRoute._value || {};
    }
}
EOF
