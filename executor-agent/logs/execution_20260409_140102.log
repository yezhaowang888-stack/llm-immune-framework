    <title>医疗器械产品管理 - 修复版本</title>
    <!-- Element Plus CSS -->
    <link rel="stylesheet" href="https://unpkg.com/element-plus/dist/index.css">
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 20px;
            background: #f5f7fa;
        }
        
        .medical-container {
            max-width: 1400px;
            margin: 0 auto;
        }
        
        .page-header {
            background: linear-gradient(135deg, #059669 0%, #10b981 100%);
            color: white;
            padding: 30px;
            border-radius: 12px;
            margin-bottom: 30px;
            box-shadow: 0 4px 12px rgba(5, 150, 105, 0.2);
        }
        
        .page-header h2 {
            margin: 0;
            font-size: 28px;
            margin-bottom: 10px;
        }
        
        .page-header p {
            margin: 0;
            opacity: 0.9;
            font-size: 16px;
        }
        
        .action-bar {
            background: white;
            padding: 20px;
            border-radius: 8px;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }
        
        .stats-cards {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 15px;
            margin-bottom: 20px;
        }
        
        .stat-card {
            background: white;
            border-radius: 8px;
            padding: 20px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            transition: transform 0.3s;
        }
        
        .stat-card:hover {
            transform: translateY(-2px);
        }
        
        .stat-content {
            text-align: center;
        }
        
        .stat-label {
            font-size: 14px;
            color: #909399;
            margin-bottom: 8px;
        }
        
        .stat-value {
            font-size: 32px;
            font-weight: bold;
            color: #303133;
        }
        
        .table-card {
            margin-top: 20px;
            border-radius: 8px;
            box-shadow: 0 2px 12px rgba(0,0,0,0.1);
        }
        
        .empty-state {
            text-align: center;
            padding: 60px 20px;
            color: #909399;
        }
        
        .empty-state i {
            font-size: 48px;
            margin-bottom: 20px;
            display: block;
        }
        
        .empty-state p {
            margin: 0;
            font-size: 16px;
        }
        
        .status-tag {
            padding: 4px 8px;
            border-radius: 4px;
            font-size: 12px;
            font-weight: 500;
        }
        
        .status-instock {
            background: #f0f9eb;
            color: #67c23a;
        }
        
        .status-lowstock {
            background: #fdf6ec;
            color: #e6a23c;
        }
        
        .status-outstock {
            background: #fef0f0;
            color: #f56c6c;
        }
        
        .price-cell {
            font-weight: bold;
            color: #1e40af;
        }
    </style>
</head>
<body>
    <div id="app" class="medical-container">
        <div class="page-header">
            <h2>🏥 医疗器械产品信息管理</h2>
            <p>管理医疗器械产品信息、库存、价格及资质证件</p>
        </div>
        
        <div class="action-bar">
            <button id="btn-add" class="el-button el-button--primary">
                <i class="el-icon-plus"></i> 新增产品
            </button>
            <button id="btn-refresh" class="el-button">
                <i class="el-icon-refresh"></i> 刷新
            </button>
            <div class="el-input" style="width: 300px; margin-left: 20px;">
                <input type="text" id="search-input" class="el-input__inner" placeholder="搜索产品名称、型号、注册证号...">
                <span class="el-input__prefix">
                    <i class="el-icon-search"></i>
                </span>
            </div>
        </div>
        
        <!-- 统计卡片 -->
        <div class="stats-cards">
            <div class="stat-card">
                <div class="stat-content">
                    <div class="stat-label">总产品数</div>
                    <div class="stat-value" id="total-products">0</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-content">
                    <div class="stat-label">库存充足</div>
                    <div class="stat-value" id="instock-products" style="color: #67c23a;">0</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-content">
                    <div class="stat-label">库存预警</div>
                    <div class="stat-value" id="lowstock-products" style="color: #e6a23c;">0</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-content">
                    <div class="stat-label">缺货产品</div>
                    <div class="stat-value" id="outstock-products" style="color: #f56c6c;">0</div>
                </div>
            </div>
        </div>
        
        <!-- 产品表格 -->
        <div class="table-card">
            <table class="el-table" style="width: 100%;">
                <thead>
                    <tr>
                        <th>产品编码</th>
                        <th>产品名称</th>
                        <th>型号</th>
                        <th>注册证号</th>
                        <th>库存数量</th>
                        <th>库存状态</th>
                        <th>销售单价</th>
                        <th>操作</th>
                    </tr>
                </thead>
                <tbody id="product-table-body">
                    <!-- 数据将通过JavaScript动态加载 -->
                </tbody>
            </table>
            
            <div id="empty-state" class="empty-state" style="display: none;">
                <i class="el-icon-document"></i>
                <p>暂无产品数据，点击"新增产品"开始添加</p>
            </div>
        </div>
    </div>
    
    <!-- Element Plus JS -->
    <script src="https://unpkg.com/element-plus/dist/index.full.js"></script>
    <script>
        // 医疗器械产品数据
        const products = [
            {
                id: 1,
                productCode: 'PROD2026001',
                productName: '一次性使用无菌注射器',
                productModel: '5ml',
                medicalLicense: '国械注准20213456789',
                stockQuantity: 150,
                unit: '支',
                minStock: 50,
                salePrice: 2.50,
                storageCondition: '常温干燥',
                supplier: '江苏医疗器械有限公司'
            },
            {
                id: 2,
                productCode: 'PROD2026002',
                productName: '医用外科口罩',
                productModel: '三层',
                medicalLicense: '国械注准20212345678',
                stockQuantity: 25,
                unit: '盒',
                minStock: 30,
                salePrice: 15.00,
                storageCondition: '常温',
                supplier: '上海医疗用品厂'
            },
            {
                id: 3,
                productCode: 'PROD2026003',
                productName: '电子体温计',
                productModel: 'DT-01',
                medicalLicense: '国械注准20211234567',
                stockQuantity: 0,
                unit: '个',
                minStock: 10,
                salePrice: 89.00,
                storageCondition: '常温防潮',
                supplier: '广东医疗设备公司'
            }
        ];
        
        // 获取库存状态
        function getStockStatus(quantity, minStock) {
            if (quantity === 0) return 'outstock';
            if (quantity < minStock) return 'lowstock';
            return 'instock';
        }
        
        // 获取状态文本
        function getStatusText(status) {
            switch(status) {
                case 'instock': return '库存充足';
                case 'lowstock': return '库存预警';
                case 'outstock': return '缺货';
                default: return '未知';
            }
        }
        
        // 获取状态类型
        function getStatusType(status) {
            switch(status) {
                case 'instock': return 'status-instock';
                case 'lowstock': return 'status-lowstock';
                case 'outstock': return 'status-outstock';
                default: return '';
            }
        }
        
        // 格式化价格
        function formatPrice(price) {
            return '¥' + (price ? price.toFixed(2) : '0.00');
        }
        
        // 渲染产品表格
        function renderProducts(productsToRender) {
            const tbody = document.getElementById('product-table-body');
            const emptyState = document.getElementById('empty-state');
            
            if (productsToRender.length === 0) {
                tbody.innerHTML = '';
                emptyState.style.display = 'block';
                return;
            }
            
            emptyState.style.display = 'none';
            
            let html = '';
            productsToRender.forEach(product => {
                const status = getStockStatus(product.stockQuantity, product.minStock);
                const statusText = getStatusText(status);
                const statusClass = getStatusType(status);
                
                html += `
                    <tr>
                        <td>${product.productCode || ''}</td>
                        <td>${product.productName || ''}</td>
                        <td>${product.productModel || ''}</td>
                        <td>${product.medicalLicense || ''}</td>
                        <td>${product.stockQuantity || 0} ${product.unit || ''}</td>
                        <td>
                            <span class="status-tag ${statusClass}">${statusText}</span>
                        </td>
                        <td class="price-cell">${formatPrice(product.salePrice)}</td>
                        <td>
                            <button class="el-button el-button--text el-button--small" onclick="editProduct(${product.id})">编辑</button>
                            <button class="el-button el-button--text el-button--small" onclick="deleteProduct(${product.id})" style="color: #f56c6c;">删除</button>
                        </td>
                    </tr>
                `;
            });
            
            tbody.innerHTML = html;
        }
        
        // 更新统计信息
        function updateStats(productsData) {
            let instock = 0, lowstock = 0, outstock = 0;
            
            productsData.forEach(product => {
                const status = getStockStatus(product.stockQuantity, product.minStock);
                if (status === 'instock') instock++;
                else if (status === 'lowstock') lowstock++;
                else if (status === 'outstock') outstock++;
            });
            
            document.getElementById('total-products').textContent = productsData.length;
            document.getElementById('instock-products').textContent = instock;
            document.getElementById('lowstock-products').textContent = lowstock;
            document.getElementById('outstock-products').textContent = outstock;
        }
        
        // 搜索产品
        function searchProducts(keyword) {
            if (!keyword) {
                renderProducts(products);
                updateStats(products);
                return;
            }
            
            const filtered = products.filter(product => 
                (product.productName && product.productName.toLowerCase().includes(keyword.toLowerCase())) ||
                (product.productCode && product.productCode.toLowerCase().includes(keyword.toLowerCase())) ||
                (product.productModel && product.productModel.toLowerCase().includes(keyword.toLowerCase())) ||
                (product.medicalLicense && product.medicalLicense.toLowerCase().includes(keyword.toLowerCase())) ||
                (product.supplier && product.supplier.toLowerCase().includes(keyword.toLowerCase()))
            );
            
            renderProducts(filtered);
            updateStats(filtered);
        }
        
        // 编辑产品
        function editProduct(id) {
            const product = products.find(p => p.id === id);
            if (product) {
                alert(`编辑产品: ${product.productName}\n功能将在完整版本中实现`);
            }
        }
        
        // 删除产品
        function deleteProduct(id) {
            if (confirm('确定要删除这个产品吗？')) {
                const index = products.findIndex(p => p.id === id);
                if (index !== -1) {
                    products.splice(index, 1);
                    renderProducts(products);
                    updateStats(products);
                    alert('产品删除成功');
                }
            }
        }
        
        // 新增产品
        document.getElementById('btn-add').addEventListener('click', function() {
            alert('新增产品功能\n功能将在完整版本中实现');
        });
        
        // 刷新数据
        document.getElementById('btn-refresh').addEventListener('click', function() {
            renderProducts(products);
            updateStats(products);
            alert('数据已刷新');
        });
        
        // 搜索输入
        document.getElementById('search-input').addEventListener('input', function(e) {
            searchProducts(e.target.value);
        });
        
        // 初始加载
        document.addEventListener('DOMContentLoaded', function() {
            renderProducts(products);
            updateStats(products);
        });
    </script>
</body>
</html>
