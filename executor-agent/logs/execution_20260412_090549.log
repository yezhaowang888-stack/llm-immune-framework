// Vue应用包装器 - 确保Vue正确加载
(function() {
    'use strict';
    
    console.log('🔄 Vue应用包装器启动...');
    
    // 等待DOM加载完成
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initVueApp);
    } else {
        initVueApp();
    }
    
    function initVueApp() {
        console.log('✅ DOM已加载，初始化Vue应用');
        
        // 检查Vue是否已加载
        if (typeof Vue === 'undefined') {
            console.error('❌ Vue.js未加载，等待Vue加载...');
            // 等待Vue加载
            setTimeout(checkVueLoaded, 100);
            return;
        }
        
        // 检查Vue Router是否已加载
        if (typeof VueRouter === 'undefined') {
            console.error('❌ Vue Router未加载，等待Vue Router加载...');
            // 等待Vue Router加载
            setTimeout(checkVueRouterLoaded, 100);
            return;
        }
        
        startVueApplication();
    }
    
    function checkVueLoaded() {
        if (typeof Vue === 'undefined') {
            console.error('❌ Vue.js仍未加载，重试...');
            setTimeout(checkVueLoaded, 100);
            return;
        }
        console.log('✅ Vue.js已加载');
        initVueApp();
    }
    
    function checkVueRouterLoaded() {
        if (typeof VueRouter === 'undefined') {
            console.error('❌ Vue Router仍未加载，重试...');
            setTimeout(checkVueRouterLoaded, 100);
            return;
        }
        console.log('✅ Vue Router已加载');
        startVueApplication();
    }
    
    function startVueApplication() {
        console.log('🚀 启动Vue应用...');
        
        // 设置全局变量供动态路由系统使用
        window.__VUE_LOADED__ = true;
        window.__VUE_ROUTER_LOADED__ = true;
        
        // 触发动态路由系统检查
        if (window.checkVueRouterReady) {
            window.checkVueRouterReady();
        }
        
        console.log('✅ Vue应用包装器完成');
    }
    
    // 导出检查函数
    window.checkVueLoaded = checkVueLoaded;
    window.checkVueRouterLoaded = checkVueRouterLoaded;
    window.startVueApplication = startVueApplication;
    
})();
EOF
