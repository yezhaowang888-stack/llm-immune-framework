// 动态路由注册 - 解决菜单项未显式注册问题
(function() {
    console.log('🔧 动态路由注册系统启动');
    
    // 等待Vue Router
    let checkCount = 0;
    function checkRouter() {
        if (window.__VUE_ROUTER__) {
            registerRoutes();
        } else if (checkCount < 50) { // 最多等待5秒
            checkCount++;
            setTimeout(checkRouter, 100);
        } else {
            console.log('⚠️ 未检测到Vue Router');
        }
    }
    
    function registerRoutes() {
        const router = window.__VUE_ROUTER__;
        console.log('✅ 检测到Vue Router，开始注册路由');
        
        // 客户管理路由
        if (!routerHasRoute(router, '/customer')) {
            router.addRoute({
                path: '/customer',
                name: 'customer',
                component: () => Promise.resolve({
                    template: '<div style="padding: 20px;"><h2>客户管理</h2><p>客户信息管理页面</p></div>'
                })
            });
            console.log('✅ 客户管理路由已注册');
        }
        
        // 产品管理路由
        if (!routerHasRoute(router, '/product')) {
            router.addRoute({
                path: '/product',
                name: 'product',
                component: () => Promise.resolve({
                    template: '<div style="padding: 20px;"><h2>产品管理</h2><p>产品信息管理页面</p></div>'
                })
            });
            console.log('✅ 产品管理路由已注册');
        }
        
        console.log('🎉 路由注册完成');
    }
    
    function routerHasRoute(router, path) {
        return router.getRoutes().some(route => route.path === path);
    }
    
    // 启动
    checkRouter();
})();
EOF
