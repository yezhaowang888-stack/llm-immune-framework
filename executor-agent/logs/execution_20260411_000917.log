// 动态菜单项注册 - 解决菜单项未显式注册问题
(function() {
    console.log('🔧 动态菜单项注册系统启动');
    
    // 等待菜单加载
    let checkCount = 0;
    function checkMenu() {
        const menu = findMenu();
        if (menu) {
            addMenuItems(menu);
        } else if (checkCount < 50) { // 最多等待5秒
            checkCount++;
            setTimeout(checkMenu, 100);
        } else {
            console.log('⚠️ 未检测到菜单容器');
        }
    }
    
    function findMenu() {
        // 尝试多种选择器
        return document.querySelector('.el-menu') || 
               document.querySelector('.sidebar-menu') ||
               document.querySelector('[class*="menu"]');
    }
    
    function addMenuItems(menu) {
        console.log('✅ 检测到菜单容器，开始添加菜单项');
        
        const menuItems = [
            { path: '/customer', title: '客户管理' },
            { path: '/product', title: '产品管理' }
        ];
        
        menuItems.forEach(item => {
            // 检查是否已存在
            if (menu.querySelector('[index="' + item.path + '"]')) {
                console.log('⚠️ 菜单项已存在:', item.title);
                return;
            }
            
            // 创建菜单项
            const li = document.createElement('li');
            li.className = 'el-menu-item';
            li.setAttribute('index', item.path);
            li.style.cssText = 'padding-left: 20px; cursor: pointer;';
            li.innerHTML = '<div class="el-menu-item-content"><i class="el-icon"></i><span>' + item.title + '</span></div>';
            
            // 查找插入位置（尝试在库存管理之后）
            const inventoryItem = menu.querySelector('[index*="inventory"]');
            if (inventoryItem && inventoryItem.parentNode) {
                inventoryItem.parentNode.insertBefore(li, inventoryItem.nextSibling);
            } else {
                // 添加到菜单末尾
                menu.appendChild(li);
            }
            
            console.log('✅ 添加菜单项:', item.title);
            
            // 添加点击事件
            li.addEventListener('click', function(e) {
                e.preventDefault();
                console.log('📱 点击菜单项:', item.title);
                
                // 高亮当前项
                document.querySelectorAll('.el-menu-item').forEach(el => {
                    el.classList.remove('is-active');
                    el.style.backgroundColor = '';
                });
                this.classList.add('is-active');
                this.style.backgroundColor = '#e6f7ff';
                
                // 导航
                if (window.__VUE_ROUTER__) {
                    window.__VUE_ROUTER__.push(item.path);
                } else {
                    window.location.href = item.path;
                }
            });
        });
        
        console.log('🎉 菜单项添加完成');
    }
    
    // 启动
    checkMenu();
})();
EOF
