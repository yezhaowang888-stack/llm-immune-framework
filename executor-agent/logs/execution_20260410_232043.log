      } else {
        // 新增
        const newId = Math.max(...customerList.value.map(item => item.id)) + 1
        customerList.value.push({
          ...formData,
          id: newId
        })
        ElMessage.success('新增成功')
      }
      showAddDialog.value = false
      resetForm()
      fetchData()
    }
  })
}

// 重置表单
const resetForm = () => {
  formData.id = ''
  formData.name = ''
  formData.type = 'hospital'
  formData.contactPerson = ''
  formData.phone = ''
  formData.email = ''
  formData.address = ''
  formData.qualificationExpiry = ''
  formData.status = 'active'
}
</script>

