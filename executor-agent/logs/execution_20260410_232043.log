<script setup>
import { ref, reactive, onMounted } from 'vue'
import { ElMessage, ElMessageBox } from 'element-plus'

// 数据
const loading = ref(false)
const currentPage = ref(1)
const pageSize = ref(10)
const total = ref(0)
const showAddDialog = ref(false)
const dialogTitle = ref('新增客户')
const formRef = ref(null)

// 搜索表单
const searchForm = reactive({
  name: '',
  type: ''
})

// 表单数据
const formData = reactive({
  id: '',
  name: '',
  type: 'hospital',
  contactPerson: '',
  phone: '',
  email: '',
  address: '',
  qualificationExpiry: '',
  status: 'active'
})

// 验证规则
const rules = {
  name: [{ required: true, message: '请输入客户名称', trigger: 'blur' }],
  type: [{ required: true, message: '请选择客户类型', trigger: 'change' }],
  contactPerson: [{ required: true, message: '请输入联系人', trigger: 'blur' }],
  phone: [{ required: true, message: '请输入联系电话', trigger: 'blur' }]
}

// 客户列表数据
const customerList = ref([
  {
    id: 1,
    name: '北京协和医院',
    type: 'hospital',
    contactPerson: '张医生',
    phone: '13800138001',
    address: '北京市东城区帅府园1号',
    qualificationExpiry: '2026-12-31',
    status: 'active'
  },
  {
    id: 2,
    name: '上海瑞金医院',
    type: 'hospital',
    contactPerson: '李主任',
    phone: '13900139002',
    address: '上海市黄浦区瑞金二路197号',
    qualificationExpiry: '2025-06-30',
    status: 'active'
  },
  {
    id: 3,
    name: '广州医疗器械公司',
    type: 'dealer',
    contactPerson: '王经理',
    phone: '13600136003',
    address: '广州市天河区珠江新城',
    qualificationExpiry: '2024-12-31',
    status: 'active'
  }
])

// 生命周期
onMounted(() => {
  fetchData()
})

// 获取数据
const fetchData = () => {
  loading.value = true
  // 模拟API调用
  setTimeout(() => {
    total.value = customerList.value.length
    loading.value = false
  }, 500)
}

// 搜索
const handleSearch = () => {
  currentPage.value = 1
  fetchData()
}

// 重置搜索
const resetSearch = () => {
  searchForm.name = ''
  searchForm.type = ''
  currentPage.value = 1
  fetchData()
}

// 刷新数据
const refreshData = () => {
  fetchData()
}

// 分页大小变化
const handleSizeChange = (val) => {
  pageSize.value = val
  fetchData()
}

// 当前页变化
const handleCurrentChange = (val) => {
  currentPage.value = val
  fetchData()
}

// 获取类型标签
const getTypeTag = (type) => {
  const map = {
    hospital: 'success',
    clinic: 'warning',
    dealer: 'info',
    other: 'default'
  }
  return map[type] || 'default'
}

// 获取类型文本
const getTypeText = (type) => {
  const map = {
    hospital: '医院',
    clinic: '诊所',
    dealer: '经销商',
    other: '其他'
  }
  return map[type] || '未知'
}

// 检查是否过期
const isExpired = (date) => {
  if (!date) return false
  const expiryDate = new Date(date)
  const today = new Date()
  return expiryDate < today
}

// 编辑客户
const handleEdit = (row) => {
  dialogTitle.value = '编辑客户'
  Object.assign(formData, row)
  showAddDialog.value = true
}

// 删除客户
const handleDelete = (row) => {
  ElMessageBox.confirm(
    `确定要删除客户"${row.name}"吗？`,
    '删除确认',
    {
      confirmButtonText: '确定',
      cancelButtonText: '取消',
      type: 'warning'
    }
  ).then(() => {
    const index = customerList.value.findIndex(item => item.id === row.id)
    if (index !== -1) {
      customerList.value.splice(index, 1)
      ElMessage.success('删除成功')
      fetchData()
    }
  }).catch(() => {
    // 用户取消
  })
}

// 提交表单
const handleSubmit = () => {
  formRef.value?.validate((valid) => {
    if (valid) {
      if (formData.id) {
        // 更新
        const index = customerList.value.findIndex(item => item.id === formData.id)
        if (index !== -1) {
          customerList.value[index] = { ...formData }
        }
        ElMessage.success('更新成功')
      } else {
        // 新增
        const newId = Math.max(...customerList.value.map(item => item.id)) + 1
        customerList.value.push({
          ...formData,
          id: newId
        })
        ElMessage.success('新增成功')
      }
      showAddDialog.value = false
      resetForm()
      fetchData()
    }
  })
}

// 重置表单
const resetForm = () => {
  formData.id = ''
  formData.name = ''
  formData.type = 'hospital'
  formData.contactPerson = ''
  formData.phone = ''
  formData.email = ''
  formData.address = ''
  formData.qualificationExpiry = ''
  formData.status = 'active'
}
</script>

