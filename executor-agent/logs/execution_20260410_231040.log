    <script>
        const { createApp, ref, computed } = Vue;
        const { ElMenu, ElMenuItem, ElSubMenu, ElIcon, ElBreadcrumb, ElBreadcrumbItem, ElBadge, ElDropdown, ElDropdownMenu, ElDropdownItem, ElAvatar } = ElementPlus;
        const { createRouter, createWebHistory } = VueRouter;
        
        // 导入所有图标
        const ElementPlusIconsVue = window.ElementPlusIconsVue;
        
        const app = createApp({
            setup() {
                const isCollapsed = ref(false);
                const toggleSidebar = () => {
                    isCollapsed.value = !isCollapsed.value;
                };
                
                return { isCollapsed, toggleSidebar };
            }
        });
        
        // 注册所有图标
        for (const [key, component] of Object.entries(ElementPlusIconsVue)) {
            app.component(key, component);
        }
        
        // 注册Element Plus组件
        app.component('ElMenu', ElMenu);
        app.component('ElMenuItem', ElMenuItem);
        app.component('ElSubMenu', ElSubMenu);
        app.component('ElIcon', ElIcon);
        app.component('ElBreadcrumb', ElBreadcrumb);
        app.component('ElBreadcrumbItem', ElBreadcrumbItem);
        app.component('ElBadge', ElBadge);
        app.component('ElDropdown', ElDropdown);
        app.component('ElDropdownMenu', ElDropdownMenu);
        app.component('ElDropdownItem', ElDropdownItem);
        app.component('ElAvatar', ElAvatar);
        
        // 创建路由
        const routes = [
            { path: '/', redirect: '/dashboard' },
            { path: '/dashboard', component: { template: '<div><h2>首页看板</h2><p>欢迎使用医疗器械管理系统</p></div>' } },
            { path: '/customer', component: { template: '<div><h2>客户管理</h2><p>客户管理页面内容</p></div>' } },
            { path: '/product', component: { template: '<div><h2>产品管理</h2><p>产品管理页面内容</p></div>' } }
        ];
        
        const router = createRouter({
            history: createWebHistory(),
            routes
        });
        
        app.use(router);
        app.use(ElementPlus);
        app.mount('#app');
    </script>
</body>
