// 简化的动态路由注册系统
(function() {
    console.log('🚀 动态路由注册系统启动');
    
    // 等待Vue Router
    function waitForRouter() {
        if (window.__VUE_ROUTER__) {
            registerRoutes();
        } else {
            setTimeout(waitForRouter, 100);
        }
    }
    
    function registerRoutes() {
        const router = window.__VUE_ROUTER__;
        console.log('✅ 注册客户管理和产品管理路由');
        
        // 客户管理路由
        if (!router.getRoutes().find(r => r.path === '/customer')) {
            router.addRoute({
                path: '/customer',
                name: 'customer',
                component: function() {
                    return Promise.resolve({
                        template: '<div style="padding: 20px;"><h2>客户管理</h2><p>客户信息管理功能</p></div>'
                    });
                }
            });
            console.log('✅ 客户管理路由已注册');
        }
        
        // 产品管理路由
        if (!router.getRoutes().find(r => r.path === '/product')) {
            router.addRoute({
                path: '/product',
                name: 'product',
                component: function() {
                    return Promise.resolve({
                        template: '<div style="padding: 20px;"><h2>产品管理</h2><p>产品信息管理功能</p></div>'
                    });
                }
            });
            console.log('✅ 产品管理路由已注册');
        }
        
        console.log('🎉 路由注册完成');
    }
    
    waitForRouter();
})();
EOF
echo '✅ 动态路由脚本已创建' && echo '' && echo '5. 创建简化的动态菜单脚本:' && cat > /opt/med-gsp-system/frontend/js/dynamic-menu.js << 'EOF'
// 简化的动态菜单项注册系统
(function() {
    console.log('🚀 动态菜单项注册系统启动');
    
    // 等待菜单加载
    function waitForMenu() {
        const menu = document.querySelector('.el-menu');
        if (menu) {
            addMenuItems(menu);
        } else {
            setTimeout(waitForMenu, 100);
        }
    }
    
    function addMenuItems(menu) {
        console.log('✅ 检测到菜单，添加客户管理和产品管理菜单项');
        
        // 菜单项配置
        const items = [
            { path: '/customer', title: '客户管理' },
            { path: '/product', title: '产品管理' }
        ];
        
        items.forEach(item => {
            // 检查是否已存在
            if (menu.querySelector('[index="' + item.path + '"]')) {
                console.log('⚠️ 菜单项已存在:', item.title);
                return;
            }
            
            // 创建菜单项
            const li = document.createElement('li');
            li.className = 'el-menu-item';
            li.setAttribute('index', item.path);
            li.style.cssText = 'padding-left: 20px; cursor: pointer;';
            li.innerHTML = '<div class="el-menu-item-content"><i class="el-icon"></i><span>' + item.title + '</span></div>';
            
            // 查找插入位置（在库存管理之后）
            const inventoryItem = menu.querySelector('[index*="inventory"]');
            if (inventoryItem && inventoryItem.parentNode) {
                inventoryItem.parentNode.insertBefore(li, inventoryItem.nextSibling);
            } else {
                menu.appendChild(li);
            }
            
            console.log('✅ 添加菜单项:', item.title);
            
            // 添加点击事件
            li.addEventListener('click', function(e) {
                e.preventDefault();
                console.log('📱 点击菜单项:', item.title);
                
                // 导航
                if (window.__VUE_ROUTER__) {
                    window.__VUE_ROUTER__.push(item.path);
                } else {
                    window.location.href = item.path;
                }
            });
        });
        
        console.log('🎉 菜单项添加完成');
    }
    
    waitForMenu();
})();
EOF
