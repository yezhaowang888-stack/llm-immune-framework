                    test1.innerHTML += '<p class="success">✅ 产品管理菜单项位置正确（在库存管理和报表分析之间）</p>';
                } else if (productIndex >= 0) {
                    test1.innerHTML += '<p class="warning">⚠️ 产品管理菜单项位置可能不正确</p>';
                }
                
