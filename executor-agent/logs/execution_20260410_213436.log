#!/bin/bash
FILE="/opt/med-gsp-system/frontend/js/app.3b24beff.js"

echo "修复菜单渲染问题..."

# 查找库存管理菜单项的位置
INVENTORY_MENU_LINE=$(grep -n '库存管理' "$FILE" | grep -v 'meta:{title:' | head -1 | cut -d: -f1)
echo "库存管理菜单项在第 $INVENTORY_MENU_LINE 行"

# 查找报表分析菜单项的位置
REPORT_MENU_LINE=$(grep -n '报表分析' "$FILE" | grep -v 'meta:{title:' | head -1 | cut -d: -f1)
echo "报表分析菜单项在第 $REPORT_MENU_LINE 行"

if [ -n "$INVENTORY_MENU_LINE" ] && [ -n "$REPORT_MENU_LINE" ]; then
    echo "找到菜单项位置"
    
    # 检查库存管理和报表分析之间是否有客户和产品管理菜单项
    echo "检查库存管理和报表分析之间的内容..."
    sed -n "$((INVENTORY_MENU_LINE+1)),$((REPORT_MENU_LINE-1))p" "$FILE" | grep -n '客户管理\|产品管理'
    
    # 如果没有，添加客户和产品管理菜单项
    CUSTOMER_MENU_ITEM='        <el-menu-item index="/customer"><el-icon><el-icon-user /></el-icon><span>客户管理</span></el-menu-item>'
    PRODUCT_MENU_ITEM='        <el-menu-item index="/product"><el-icon><el-icon-box /></el-icon><span>产品管理</span></el-menu-item>'
    
    # 在报表分析之前插入
    sed -i "${REPORT_MENU_LINE}i\${CUSTOMER_MENU_ITEM}" "$FILE"
    sed -i "${REPORT_MENU_LINE}i\${PRODUCT_MENU_ITEM}" "$FILE"
    
    echo "✅ 已添加客户和产品管理菜单项"
else
    echo "❌ 未找到菜单项位置"
fi

echo "修复完成"
SH
