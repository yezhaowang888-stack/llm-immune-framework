    <script>
        // 测试1: 菜单项检查
        const test1 = document.getElementById('test1');
        fetch('/js/app.3b24beff.js')
            .then(response => response.text())
            .then(text => {
                // 检查客户管理菜单项
                if (text.includes('index="/customer"')) {
                    test1.innerHTML += '<p class="success">✅ 客户管理菜单项存在 (index="/customer")</p>';
                } else {
                    test1.innerHTML += '<p class="error">❌ 客户管理菜单项不存在</p>';
                }
                
                // 检查产品管理菜单项
                if (text.includes('index="/product"')) {
                    test1.innerHTML += '<p class="success">✅ 产品管理菜单项存在 (index="/product")</p>';
                } else {
                    test1.innerHTML += '<p class="error">❌ 产品管理菜单项不存在</p>';
                }
                
                // 检查菜单项位置
                const lines = text.split('\n');
                let inventoryIndex = -1;
                let reportIndex = -1;
                let customerIndex = -1;
                let productIndex = -1;
                
                for (let i = 0; i < lines.length; i++) {
                    if (lines[i].includes('库存管理') && lines[i].includes('el-menu-item')) {
                        inventoryIndex = i;
                    }
                    if (lines[i].includes('报表分析') && lines[i].includes('el-menu-item')) {
                        reportIndex = i;
                    }
                    if (lines[i].includes('客户管理') && lines[i].includes('el-menu-item')) {
                        customerIndex = i;
                    }
                    if (lines[i].includes('产品管理') && lines[i].includes('el-menu-item')) {
                        productIndex = i;
                    }
                }
                
                test1.innerHTML += '<p>菜单项位置分析:</p>';
                test1.innerHTML += '<p>库存管理菜单项行: ' + (inventoryIndex >= 0 ? inventoryIndex : '未找到') + '</p>';
                test1.innerHTML += '<p>报表分析菜单项行: ' + (reportIndex >= 0 ? reportIndex : '未找到') + '</p>';
                test1.innerHTML += '<p>客户管理菜单项行: ' + (customerIndex >= 0 ? customerIndex : '未找到') + '</p>';
                test1.innerHTML += '<p>产品管理菜单项行: ' + (productIndex >= 0 ? productIndex : '未找到') + '</p>';
                
                if (customerIndex > inventoryIndex && customerIndex < reportIndex) {
                    test1.innerHTML += '<p class="success">✅ 客户管理菜单项位置正确（在库存管理和报表分析之间）</p>';
                } else if (customerIndex >= 0) {
                    test1.innerHTML += '<p class="warning">⚠️ 客户管理菜单项位置可能不正确</p>';
                }
                
                if (productIndex > inventoryIndex && productIndex < reportIndex) {
                    test1.innerHTML += '<p class="success">✅ 产品管理菜单项位置正确（在库存管理和报表分析之间）</p>';
                } else if (productIndex >= 0) {
                    test1.innerHTML += '<p class="warning">⚠️ 产品管理菜单项位置可能不正确</p>';
                }
                
                test1.innerHTML += '<p><strong>菜单项检查完成</strong></p>';
            })
            .catch(err => {
                test1.innerHTML += '<p class="error">❌ 菜单项检查失败: ' + err.message + '</p>';
            });
        
        // 测试2: 路由配置检查
        const test2 = document.getElementById('test2');
        fetch('/js/app.3b24beff.js')
            .then(response => response.text())
            .then(text => {
                // 检查客户路由配置
                if (text.includes('path:"/customer"') && text.includes('客户管理')) {
                    test2.innerHTML += '<p class="success">✅ 客户管理路由配置存在</p>';
                } else {
                    test2.innerHTML += '<p class="error">❌ 客户管理路由配置不存在</p>';
                }
                
                // 检查产品路由配置
                if (text.includes('path:"/product"') && text.includes('产品管理')) {
                    test2.innerHTML += '<p class="success">✅ 产品管理路由配置存在</p>';
                } else {
                    test2.innerHTML += '<p class="error">❌ 产品管理路由配置不存在</p>';
                }
                
                // 检查路由定义数量
                const customerCount = (text.match(/path.*customer/g) || []).length;
                const productCount = (text.match(/path.*product/g) || []).length;
                
                test2.innerHTML += '<p>客户路由定义数量: ' + customerCount + '</p>';
                test2.innerHTML += '<p>产品路由定义数量: ' + productCount + '</p>';
                
                if (customerCount === 1) {
                    test2.innerHTML += '<p class="success">✅ 客户路由定义正常 (无重复)</p>';
                } else {
                    test2.innerHTML += '<p class="error">❌ 客户路由定义异常</p>';
                }
                
                if (productCount === 1) {
                    test2.innerHTML += '<p class="success">✅ 产品路由定义正常 (无重复)</p>';
                } else {
                    test2.innerHTML += '<p class="error">❌ 产品路由定义异常</p>';
                }
                
                test2.innerHTML += '<p><strong>路由配置检查完成</strong></p>';
            })
            .catch(err => {
                test2.innerHTML += '<p class="error">❌ 路由配置检查失败: ' + err.message + '</p>';
            });
    </script>
</body>
