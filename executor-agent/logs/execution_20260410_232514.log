_exports__ = /*#__PURE__*/exportComponent(script, [['render',render]])\n\nexport default __exports__","<template>\r\n  <div class=\"login-container\">\r\n    <div class=\"login-box\">\r\n      <!-- Logo和标题 -->\r\n      <div class=\"login-header\">\r\n        <img src=\"@/assets/logo.png\" alt=\"惠迈生物\" class=\"logo\">\r\n        <h2 class=\"company-name\">山东惠迈生物科技有限公司</h2>\r\n        <p class=\"system-name\">医疗器械管理系统 v1.0</p>\r\n      </div>\r\n\r\n      <!-- 登录表单 -->\r\n      <el-form \r\n        ref=\"formRef\"\r\n        :model=\"form\"\r\n        :rules=\"rules\"\r\n        class=\"login-form\"\r\n        @keyup.enter=\"handleLogin\"\r\n      >\r\n        <!-- 用户名 -->\r\n        <el-form-item prop=\"username\">\r\n          <el-input\r\n            v-model=\"form.username\"\r\n            placeholder=\"工号/手机号/邮箱\"\r\n            :prefix-icon=\"User\"\r\n            size=\"large\"\r\n            clearable\r\n          />\r\n          <div class=\"input-hint\">📝 工号/手机号/邮箱</div>\r\n        </el-form-item>\r\n\r\n        <!-- 密码 -->\r\n        <el-form-item prop=\"password\">\r\n          <el-input\r\n            v-model=\"form.password\"\r\n            type=\"password\"\r\n            placeholder=\"密码\"\r\n            :prefix-icon=\"Lock\"\r\n            size=\"large\"\r\n            show-password\r\n            clearable\r\n          />\r\n          <div class=\"input-hint\">🔒 6-20位字符，区分大小写</div>\r\n        </el-form-item>\r\n\r\n        <!-- 记住密码和忘记密码 -->\r\n        <div class=\"form-options\">\r\n          <el-checkbox v-model=\"form.remember\">记住密码</el-checkbox>\r\n          <el-link type=\"primary\" :underline=\"false\">忘记密码？</el-link>\r\n        </div>\r\n\r\n        <!-- 登录按钮 -->\r\n        <el-button\r\n          type=\"primary\"\r\n          size=\"large\"\r\n          :loading=\"loading\"\r\n          class=\"login-button\"\r\n          @click=\"handleLogin\"\r\n        >\r\n          {{ loading ? '登录中...' : '登录' }}\r\n        </el-button>\r\n\r\n        <!-- 其他登录方式 -->\r\n        <div class=\"other-login\">\r\n          <span class=\"other-login-text\">其他登录方式：</span>\r\n          <el-button text>📱 验证码登录</el-button>\r\n          <el-button text>👤 扫码登录</el-button>\r\n        </div>\r\n      </el-form>\r\n\r\n      <!-- 版权信息 -->\r\n      <div class=\"login-footer\">\r\n        <p>© 2026 山东惠迈生物科技有限公司</p>\r\n        <p>版本号: v1.0.0</p>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script setup>\r\nimport { ref, reactive } from 'vue'\r\nimport { useRouter } from 'vue-router'\r\nimport { ElMessage } from 'element-plus'\r\nimport { User, Lock } from '@element-plus/icons-vue'\r\nimport axios from 'axios'\r\n\r\nconst router = useRouter()\r\nconst formRef = ref(null)\r\nconst loading = ref(false)\r\n\r\nconst form = reactive({\r\n  username: '',\r\n  password: '',\r\n  remember: false\r\n})\r\n\r\nconst rules = {\r\n  username: [\r\n    { required: true, message: '请输入用户名', trigger: 'blur' },\r\n    { min: 3, max: 20, message: '长度在 3 到 20 个字符', trigger: 'blur' }\r\n  ],\r\n  password: [\r\n    { required: true, message: '请输入密码', trigger: 'blur' },\r\n    { min: 6, max: 20, message: '长度在 6 到 20 个字符', trigger: 'blur' }\r\n  ]\r\n}\r\n\r\nconst handleLogin = async () => {\r\n  if (!formRef.value) return\r\n  \r\n  await formRef.value.validate(async (valid) => {\r\n    if (valid) {\r\n      loading.value = true\r\n      try {\r\n        // 调用后端登录接口\r\n        const res = await axios.post('/api/users/login', {\r\n          username: form.username,\r\n          password: form.password\r\n        })\r\n        \r\n        if (res.data.success) {\r\n          // 保存用户信息到 localStorage\r\n          const userInfo = {\r\n            id: res.data.id,\r\n            username: res.data.username,\r\n            realName: res.data.realName,\r\n            role: res.data.role,\r\n            token: res.data.token\r\n          }\r\n          localStorage.setItem('user', JSON.stringify(userInfo))\r\n          \r\n          ElMessage.success(res.data.message)\r\n          router.push('/dashboard')\r\n        } else {\r\n          ElMessage.error(res.data.message)\r\n        }\r\n      } catch (error) {\r\n        console.error('登录失败:', error)\r\n        ElMessage.error('登录失败：' + (error.response?.data?.message || error.message))\r\n      } finally {\r\n        loading.value = false\r\n      }\r\n    }\r\n  })\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.login-container {\r\n  min-height: 100vh;\r\n  display: flex;\r\n  justify-content: center;\r\n  align-items: center;\r\n  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\r\n}\r\n\r\n.login-box {\r\n  width: 420px;\r\n  padding: 40px;\r\n  background: white;\r\n  border-radius: 8px;\r\n  box-shadow: 0 2px 12px 0 rgba(0, 0, 0, 0.1);\r\n}\r\n\r\n.login-header {\r\n  text-align: center;\r\n  margin-bottom: 30px;\r\n}\r\n\r\n.logo {\r\n  width: 80px;\r\n  height: auto;\r\n  margin-bottom: 10px;\r\n}\r\n\r\n.company-name {\r\n  font-size: 18px;\r\n  font-weight: 600;\r\n  color: #333;\r\n  margin: 0 0 5px;\r\n}\r\n\r\n.system-name {\r\n  font-size: 14px;\r\n  color: #666;\r\n  margin: 0;\r\n}\r\n\r\n.input-hint {\r\n  font-size: 12px;\r\n  color: #999;\r\n  margin-top: 4px;\r\n  padding-left: 4px;\r\n}\r\n\r\n.form-options {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  margin: 10px 0 20px;\r\n}\r\n\r\n.login-button {\r\n  width: 100%;\r\n  height: 44px;\r\n  font-size: 16px;\r\n  margin-bottom: 20px;\r\n}\r\n\r\n.other-login {\r\n  display: flex;\r\n  justify-content: center;\r\n  align-items: center;\r\n  gap: 15px;\r\n  font-size: 14px;\r\n}\r\n\r\n.other-login-text {\r\n  color: #666;\r\n}\r\n\r\n.login-footer {\r\n  margin-top: 30px;\r\n  text-align: center;\r\n  font-size: 12px;\r\n  color: #999;\r\n}\r\n\r\n.login-footer p {\r\n  margin: 2px 0;\r\n}\r\n</style>","import script from \"./Home.vue?vue&type=script&setup=true&lang=js\"\nexport * from \"./Home.vue?vue&type=script&setup=true&