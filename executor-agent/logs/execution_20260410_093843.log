<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <title>组件修复验证测试</title>
    <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
    <script src="https://unpkg.com/element-plus/dist/index.full.js"></script>
    <link rel="stylesheet" href="https://unpkg.com/element-plus/dist/index.css">
</head>
<body>
    <div id="app">
        <h2>组件修复验证测试</h2>
        <div id="result">测试中...</div>
    </div>
    <script>
        const { createApp } = Vue;
        
        const app = createApp({
            mounted() {
                const result = document.getElementById('result');
                result.innerHTML = '<h3>测试结果:</h3>';
                
                // 测试1: 直接加载组件文件
                console.log('测试1: 直接加载组件文件...');
                fetch('/js/components/customerList.js')
                    .then(response => response.text())
                    .then(text => {
                        console.log('✅ 客户管理组件文件可访问');
                        result.innerHTML += '<p style="color:green;">✅ 客户管理组件文件可访问</p>';
                        
                        // 检查是否有双点号错误
                        if (text.includes('this..info')) {
                            result.innerHTML += '<p style="color:red;">❌ 发现双点号语法错误</p>';
                        } else {
                            result.innerHTML += '<p style="color:green;">✅ 无双点号语法错误</p>';
                        }
                    })
                    .catch(err => {
                        console.error('❌ 客户管理组件文件访问失败:', err);
                        result.innerHTML += '<p style="color:red;">❌ 客户管理组件文件访问失败</p>';
                    });
                
                // 测试2: 动态导入
                setTimeout(() => {
                    console.log('测试2: 动态导入组件...');
                    try {
                        import('/js/components/customerList.js').then(module => {
                            console.log('✅ 客户管理组件动态导入成功');
                            result.innerHTML += '<p style="color:green;">✅ 客户管理组件动态导入成功</p>';
                        }).catch(err => {
                            console.error('❌ 客户管理组件动态导入失败:', err);
                            result.innerHTML += '<p style="color:red;">❌ 动态导入失败: ' + err.message + '</p>';
                        });
                    } catch (err) {
                        console.error('❌ 动态导入语法错误:', err);
                        result.innerHTML += '<p style="color:red;">❌ 动态导入语法错误</p>';
                    }
                }, 1000);
                
                // 测试3: 测试产品管理组件
                setTimeout(() => {
                    fetch('/js/components/productList.js')
                        .then(response => response.text())
                        .then(text => {
                            console.log('✅ 产品管理组件文件可访问');
                            result.innerHTML += '<p style="color:green;">✅ 产品管理组件文件可访问</p>';
                        })
                        .catch(err => {
                            console.error('❌ 产品管理组件文件访问失败:', err);
                            result.innerHTML += '<p style="color:red;">❌ 产品管理组件文件访问失败</p>';
                        });
                }, 2000);
            }
        });
        
        app.use(ElementPlus);
        app.mount('#app');
    </script>
</body>
</html>
