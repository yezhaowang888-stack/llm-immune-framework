        </div>
    </div>
    
    <!-- 加载主应用 -->
    <script>
        // 控制台输出
        function logToConsole(message, type = 'info') {
            const consoleEl = document.getElementById('console-output');
            const line = document.createElement('div');
            line.className = 'console-line ' + type;
            line.textContent = '[' + new Date().toLocaleTimeString() + '] ' + message;
            consoleEl.appendChild(line);
            consoleEl.scrollTop = consoleEl.scrollHeight;
        }
        
        // 更新状态
        function updateStatus(itemIndex, status, message) {
            const items = document.querySelectorAll('.status-item');
            if (items[itemIndex]) {
                const icon = items[itemIndex].querySelector('.status-icon');
                const text = items[itemIndex].querySelector('.status-text');
                
                icon.className = 'status-icon ' + status;
                icon.textContent = status === 'success' ? '✓' : 
                                  status === 'warning' ? '⏳' : 
                                  status === 'error' ? '✗' : '?';
                
                if (message) {
                    text.textContent = message;
                }
            }
        }
        
        // 初始化日志
        logToConsole('开始加载动态路由系统...', 'info');
        updateStatus(2, 'warning', '动态路由注册中...');
        
        // 加载动态路由脚本
        const script = document.createElement('script');
        script.src = '/js/dynamic-router.js';
        script.onload = function() {
            logToConsole('动态路由脚本加载成功', 'success');
            updateStatus(2, 'success', '动态路由脚本已加载');
        };
        script.onerror = function() {
            logToConsole('动态路由脚本加载失败', 'error');
            updateStatus(2, 'error', '脚本加载失败');
        };
        document.head.appendChild(script);
        
        // 监听路由注册完成
        let checkCount = 0;
        const checkInterval = setInterval(function() {
            checkCount++;
            if (window.__dynamicRouter) {
                clearInterval(checkInterval);
                logToConsole('动态路由系统就绪', 'success');
                
                // 检查路由
                const routes = window.__dynamicRouter.getRoutes();
                const customerRoute = routes.find(r => r.path === '/customer');
                const productRoute = routes.find(r => r.path === '/product');
                
                if (customerRoute) {
                    logToConsole('客户管理路由已注册', 'success');
                    updateStatus(3, 'success', '客户管理路由: 已注册');
                    document.getElementById('customer-link').style.backgroundColor = '#67c23a';
                }
                
                if (productRoute) {
                    logToConsole('产品管理路由已注册', 'success');
                    updateStatus(4, 'success', '产品管理路由: 已注册');
                    document.getElementById('product-link').style.backgroundColor = '#67c23a';
                }
                
                if (!customerRoute || !productRoute) {
                    logToConsole('部分路由注册失败，尝试手动注册...', 'warning');
                    // 可以在这里手动触发注册
                }
            } else if (checkCount > 50) {
                clearInterval(checkInterval);
                logToConsole('动态路由系统初始化超时', 'error');
                updateStatus(2, 'error', '初始化超时');
            }
        }, 200);
        
        // 链接点击处理
        document.querySelectorAll('a[href^="/"]').forEach(link => {
            link.addEventListener('click', function(e) {
                const href = this.getAttribute('href');
                logToConsole('导航到: ' + href, 'info');
                
                // 如果是新注册的路由，确保路由存在
                if ((href === '/customer' || href === '/product') && window.__dynamicRouter) {
                    const routes = window.__dynamicRouter.getRoutes();
                    const routeExists = routes.some(r => r.path === href);
                    
                    if (!routeExists) {
                        e.preventDefault();
                        logToConsole('路由尚未注册，正在尝试动态添加...', 'warning');
                        
                        // 动态添加路由
                        const routeName = href === '/customer' ? 'customer' : 'product';
                        const routeTitle = href === '/customer' ? '客户管理' : '产品管理';
                        
                        const success = window.__dynamicRouter.addRoute({
                            path: href,
                            name: routeName,
                            component: () => Promise.resolve({
                                template: '<div style="padding: 20px;"><h2>' + routeTitle + '</h2><p>动态加载的组件</p></div>'
                            }),
                            meta: { title: routeTitle }
                        });
                        
                        if (success) {
                            logToConsole('路由动态添加成功，正在导航...', 'success');
                            setTimeout(() => {
                                window.location.href = href;
                            }, 500);
                        } else {
                            logToConsole('路由添加失败，Vue Router未就绪', 'error');
                        }
                    }
                }
            });
        });
    </script>
    
    <!-- 加载主应用框架 -->
    <script src="/js/chunk-vendors.js"></script>
    <script src="/js/app.3b24beff.js"></script>
</body>
</html>
