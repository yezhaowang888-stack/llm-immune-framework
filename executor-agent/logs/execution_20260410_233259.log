任务ID: echo '=== 创建Vue.js运行时动态注册插件 ===' && echo '' && echo '1. 创建动态路由注册脚本:' && cat > /opt/med-gsp-system/frontend/js/dynamic-router.js << 'EOF'
/**
 * Vue.js 动态路由注册插件
 * 在运行时动态注册客户管理和产品管理路由
 * 解决编译时注册缺失的问题
 */

(function() {
    console.log('🚀 Vue.js动态路由注册插件启动...');
    
    // 等待Vue和Vue Router加载完成
    function waitForVueRouter() {
        if (window.Vue && window.VueRouter) {
            initDynamicRouter();
        } else {
            setTimeout(waitForVueRouter, 100);
        }
    }
    
    function initDynamicRouter() {
        console.log('✅ Vue Router已加载，开始动态注册路由...');
        
        // 获取当前路由实例
        const router = window.__VUE_ROUTER__;
        if (!router) {
            console.warn('⚠️ 未找到Vue Router实例');
            return;
        }
        
        // 动态导入组件函数
        async function loadComponent(path) {
            try {
                const module = await import(path);
                return module.default || module;
            } catch (error) {
                console.error('组件加载失败:', path, error);
                // 返回一个简单的错误组件
                return {
                    template: '<div style="padding: 20px; color: #f56c6c;">' +
                             '<h3>组件加载失败</h3>' +
                             '<p>路径: ' + path + '</p>' +
                             '<p>错误: ' + error.message + '</p>' +
                             '</div>'
                };
            }
        }
        
        // 定义要动态添加的路由
        const dynamicRoutes = [
            {
                path: '/customer',
                name: 'customer',
                component: () => loadComponent('../views/customer/index.vue'),
                meta: { title: '客户管理', requiresAuth: true }
            },
            {
                path: '/product',
                name: 'product',
                component: () => loadComponent('../views/product/index.vue'),
                meta: { title: '产品管理', requiresAuth: true }
            }
        ];
        
        // 检查路由是否已存在
        const existingRoutes = router.getRoutes();
        let addedCount = 0;
        
        dynamicRoutes.forEach(route => {
            const exists = existingRoutes.some(r => r.path === route.path);
            if (!exists) {
                router.addRoute(route);
                console.log('✅ 动态注册路由:', route.path);
                addedCount++;
            } else {
                console.log('⚠️ 路由已存在:', route.path);
            }
        });
        
        if (addedCount > 0) {
            console.log('🎉 成功动态注册了 ' + addedCount + ' 个路由');
            
            // 更新菜单状态（如果应用有菜单组件）
            updateMenuState();
            
            // 如果当前路径匹配新路由，重新导航
            const currentPath = window.location.pathname;
            if (dynamicRoutes.some(route => route.path === currentPath)) {
                console.log('🔄 重新导航到当前路径:', currentPath);
                router.replace(currentPath);
            }
        } else {
            console.log('📝 所有路由已存在，无需动态注册');
        }
    }
    
    // 更新菜单状态
    function updateMenuState() {
        // 尝试找到菜单组件并更新
        setTimeout(() => {
            const menuItems = document.querySelectorAll('.el-menu-item, .el-sub-menu');
            menuItems.forEach(item => {
                const text = item.textContent || '';
                if (text.includes('客户管理') || text.includes('产品管理')) {
                    item.style.backgroundColor = '#e6f7ff';
                    item.style.borderLeft = '3px solid #409EFF';
                    console.log('🎨 高亮菜单项:', text.trim());
                }
            });
        }, 1000);
    }
    
    // 创建全局路由访问器
    window.__dynamicRouter = {
        addRoute: function(route) {
            if (window.__VUE_ROUTER__) {
                window.__VUE_ROUTER__.addRoute(route);
                return true;
            }
            return false;
        },
        getRoutes: function() {
            return window.__VUE_ROUTER__ ? window.__VUE_ROUTER__.getRoutes() : [];
        },
        refresh: function() {
            if (window.__VUE_ROUTER__) {
                window.__VUE_ROUTER__.replace(window.location.pathname);
            }
        }
    };
    
    // 启动等待
    waitForVueRouter();
    
    // 监听路由变化
    window.addEventListener('popstate', function() {
        console.log('📍 路由变化:', window.location.pathname);
    });
    
    console.log('🚀 动态路由注册插件初始化完成');
})();
EOF
