#!/bin/bash
FILE="/opt/med-gsp-system/frontend/js/app.3b24beff.js"
echo "紧急修复菜单项..."

# 检查文件大小
SIZE=$(stat -c%s "$FILE")
echo "文件大小: $SIZE 字节"

# 备份文件
cp "$FILE" "$FILE.backup-emergency"

# 查找库存管理菜单项
INVENTORY_LINE=$(grep -n '库存管理' "$FILE" | grep -v 'meta:{title:' | head -1 | cut -d: -f1)
echo "库存管理在第 $INVENTORY_LINE 行"

# 查找报表分析菜单项
REPORT_LINE=$(grep -n '报表分析' "$FILE" | grep -v 'meta:{title:' | head -1 | cut -d: -f1)
echo "报表分析在第 $REPORT_LINE 行"

if [ -n "$INVENTORY_LINE" ] && [ -n "$REPORT_LINE" ]; then
    echo "找到菜单项位置"
    
    # 检查库存管理和报表分析之间是否有客户和产品管理菜单项
    echo "检查库存管理和报表分析之间的内容..."
    sed -n "$((INVENTORY_LINE+1)),$((REPORT_LINE-1))p" "$FILE" | grep -n '客户管理\|产品管理'
    
    # 如果没有，添加客户和产品管理菜单项
    CUSTOMER_MENU='        <el-menu-item index="/customer"><el-icon><el-icon-user /></el-icon><span>客户管理</span></el-menu-item>'
    PRODUCT_MENU='        <el-menu-item index="/product"><el-icon><el-icon-box /></el-icon><span>产品管理</span></el-menu-item>'
    
    # 在报表分析之前插入
    sed -i "${REPORT_LINE}i\${CUSTOMER_MENU}" "$FILE"
    sed -i "${REPORT_LINE}i\${PRODUCT_MENU}" "$FILE"
    
    echo "✅ 已添加客户和产品管理菜单项"
else
    echo "❌ 未找到菜单项位置，尝试其他方法"
    
    # 查找el-menu容器
    MENU_CONTAINER=$(grep -n 'el-menu' "$FILE" | head -1 | cut -d: -f1)
    if [ -n "$MENU_CONTAINER" ]; then
        echo "找到el-menu容器在第 $MENU_CONTAINER 行"
        
        # 在el-menu容器内添加菜单项
        CUSTOMER_MENU='        <el-menu-item index="/customer"><el-icon><el-icon-user /></el-icon><span>客户管理</span></el-menu-item>'
        PRODUCT_MENU='        <el-menu-item index="/product"><el-icon><el-icon-box /></el-icon><span>产品管理</span></el-menu-item>'
        
        # 在el-menu容器后添加
        sed -i "${MENU_CONTAINER}a\${CUSTOMER_MENU}" "$FILE"
        sed -i "${MENU_CONTAINER}a\${PRODUCT_MENU}" "$FILE"
        
        echo "✅ 已在el-menu容器内添加菜单项"
    else
        echo "❌ 未找到el-menu容器"
    fi
fi

echo "修复完成"
SH
chmod +x /opt/med-gsp-system/frontend/js/fix-menu-immediately.sh && /opt/med-gsp-system/frontend/js/fix-menu-immediately.sh && echo '' && echo '10. 验证修复结果:' && echo '检查客户管理菜单项...' && grep -n 'index="/customer"' /opt/med-gsp-system/frontend/js/app.3b24beff.js && echo '' && echo '检查产品管理菜单项...' && grep -n 'index="/product"' /opt/med-gsp-system/frontend/js/app.3b24beff.js && echo '' && echo '11. 重启Nginx:' && nginx -s reload && echo '✅ Nginx已重启' && echo '' && echo '12. 创建最终确认页面:' && cat > /opt/med-gsp-system/frontend/final-confirmation.html << 'HTML'
