                    result.innerHTML += '<p class="error">❌ 产品管理菜单项不存在</p>';
                }
                
                // 检查路由配置
                if (text.includes('path:"/customer"') && text.includes('客户管理')) {
                    result.innerHTML += '<p class="success">✅ 客户管理路由配置存在</p>';
                } else {
                    result.innerHTML += '<p class="error">❌ 客户管理路由配置不存在</p>';
                }
                
                if (text.includes('path:"/product"') && text.includes('产品管理')) {
                    result.innerHTML += '<p class="success">✅ 产品管理路由配置存在</p>';
                } else {
                    result.innerHTML += '<p class="error">❌ 产品管理路由配置不存在</p>';
                }
                
                result.innerHTML += '<p><strong>检查完成，请测试主应用</strong></p>';
            })
            .catch(err => {
                result.innerHTML += '<p class="error">❌ 检查失败: ' + err.message + '</p>';
            });
    </script>
</body>
</html>
