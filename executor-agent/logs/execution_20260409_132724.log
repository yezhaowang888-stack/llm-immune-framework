                        contactPerson: '王总监',
                        contactPhone: '13700137002',
                        qualificationExpiry: '2025-12-31'
                    }
                ];
                localStorage.setItem(STORAGE_KEY, JSON.stringify(sampleData));
                return sampleData;
            }
            return JSON.parse(existingData);
        }
        
        // 获取所有客户
        function getAllCustomers() {
            return initSampleData();
        }
        
        // 保存客户数据
        function saveCustomerData(customers) {
            localStorage.setItem(STORAGE_KEY, JSON.stringify(customers));
        }
        
        // 页面加载时初始化
        document.addEventListener('DOMContentLoaded', function() {
            console.log('页面加载完成，开始初始化数据...');
            loadCustomers();
        });
        
        // 加载客户列表
        function loadCustomers() {
            console.log('正在加载客户数据...');
            const customers = getAllCustomers();
            console.log('获取到客户数据:', customers);
            renderCustomers(customers);
            updateStats(customers);
        }
        
        // 渲染客户表格
        function renderCustomers(customers) {
            const container = document.getElementById('customerList');
            
            if (!customers || customers.length === 0) {
                container.innerHTML = '<p style="color: #95a5a6; text-align: center; padding: 40px;">暂无客户数据，点击"新增客户"开始添加</p>';
                return;
            }
            
            let html = '<table>';
            html += '<tr><th>客户编码</th><th>客户名称</th><th>统一信用代码</th><th>联系人</th><th>联系电话</th><th>资质到期</th><th>状态</th><th>操作</th></tr>';
            
            customers.forEach(customer => {
                const status = getQualificationStatus(customer.qualificationExpiry);
                const statusClass = 'status-' + status;
                const statusText = getStatusText(status);
                
                html += `<tr>
                    <td>${customer.customerCode || ''}</td>
                    <td>${customer.customerName || ''}</td>
                    <td>${customer.creditCode || ''}</td>
                    <td>${customer.contactPerson || ''}</td>
                    <td>${customer.contactPhone || ''}</td>
                    <td>${customer.qualificationExpiry || ''}</td>
                    <td class="${statusClass}">${statusText}</td>
                    <td>
                        <button onclick="editCustomer(${customer.id})" style="padding: 5px 10px; margin-right: 5px; background: #3498db; color: white; border: none; border-radius: 3px; cursor: pointer;">编辑</button>
                        <button onclick="deleteCustomer(${customer.id})" style="padding: 5px 10px; background: #e74c3c; color: white; border: none; border-radius: 3px; cursor: pointer;">删除</button>
                    </td>
                </tr>`;
            });
            
            html += '</table>';
            container.innerHTML = html;
            console.log('客户表格渲染完成');
        }
        
        // 更新统计信息
        function updateStats(customers) {
            let valid = 0, expiring = 0, expired = 0;
            
            customers.forEach(customer => {
                const status = getQualificationStatus(customer.qualificationExpiry);
                if (status === 'valid') valid++;
                else if (status === 'expiring') expiring++;
                else if (status === 'expired') expired++;
            });
            
            document.getElementById('totalCustomers').textContent = customers.length;
            document.getElementById('validCustomers').textContent = valid;
            document.getElementById('expiringCustomers').textContent = expiring;
            document.getElementById('expiredCustomers').textContent = expired;
            
            console.log('统计更新完成:', { total: customers.length, valid, expiring, expired });
        }
        
        // 获取资质状态
        function getQualificationStatus(expiryDate) {
            if (!expiryDate) return 'unknown';
            const expiry = new Date(expiryDate);
            const today = new Date();
            const daysDiff = Math.ceil((expiry - today) / (1000 * 60 * 60 * 24));
            
            if (daysDiff < 0) return 'expired';
            if (daysDiff <= 30) return 'expiring';
            return 'valid';
        }
        
        // 获取状态文本
        function getStatusText(status) {
            switch(status) {
                case 'valid': return '有效';
                case 'expiring': return '即将到期';
                case 'expired': return '已过期';
                default: return '未知';
            }
        }
        
        // 显示新增模态框
        function showAddModal() {
            document.getElementById('modalTitle').textContent = '新增客户';
            document.getElementById('customerForm').reset();
            document.getElementById('customerId').value = '';
            document.getElementById('customerModal').classList.add('show');
        }
        
        // 编辑客户
        function editCustomer(id) {
            const customers = getAllCustomers();
            const customer = customers.find(c => c.id === id);
            
            if (customer) {
                document.getElementById('modalTitle').textContent = '编辑客户';
                document.getElementById('customerId').value = customer.id;
                document.getElementById('customerCode').value = customer.customerCode || '';
                document.getElementById('customerName').value = customer.customerName || '';
                document.getElementById('creditCode').value = customer.creditCode || '';
                document.getElementById('contactPerson').value = customer.contactPerson || '';
                document.getElementById('contactPhone').value = customer.contactPhone || '';
                document.getElementById('qualificationExpiry').value = customer.qualificationExpiry || '';
                
                document.getElementById('customerModal').classList.add('show');
            }
        }
        
        // 保存客户
        function saveCustomer(event) {
            event.preventDefault();
            
            const customer = {
                customerCode: document.getElementById('customerCode').value,
                customerName: document.getElementById('customerName').value,
                creditCode: document.getElementById('creditCode').value,
                contactPerson: document.getElementById('contactPerson').value,
                contactPhone: document.getElementById('contactPhone').value,
                qualificationExpiry: document.getElementById('qualificationExpiry').value
            };
            
            const id = document.getElementById('customerId').value;
            let customers = getAllCustomers();
            
            if (id) {
                // 更新
                const index = customers.findIndex(c => c.id === parseInt(id));
                if (index !== -1) {
                    customer.id = parseInt(id);
                    customers[index] = customer;
                }
            } else {
                // 新增
                customer.id = customers.length > 0 ? Math.max(...customers.map(c => c.id)) + 1 : 1;
                customers.push(customer);
            }
            
            saveCustomerData(customers);
            hideModal();
            loadCustomers();
            alert(id ? '客户更新成功' : '客户添加成功');
        }
        
        // 删除客户
        function deleteCustomer(id) {
            if (!confirm('确定要删除这个客户吗？')) return;
            
            let customers = getAllCustomers();
            customers = customers.filter(c => c.id !== id);
            saveCustomerData(customers);
            loadCustomers();
            alert('客户删除成功');
        }
        
        // 隐藏模态框
        function hideModal() {
            document.getElementById('customerModal').classList.remove('show');
        }
        
        // 搜索客户
        function searchCustomers(keyword) {
            const customers = getAllCustomers();
            const filtered = customers.filter(customer => 
                (customer.customerName && customer.customerName.toLowerCase().includes(keyword.toLowerCase())) ||
                (customer.customerCode && customer.customerCode.toLowerCase().includes(keyword.toLowerCase())) ||
                (customer.creditCode && customer.creditCode.toLowerCase().includes(keyword.toLowerCase())) ||
                (customer.contactPerson && customer.contactPerson.toLowerCase().includes(keyword.toLowerCase()))
            );
            renderCustomers(filtered);
        }
        
        // 导出数据
        function exportData() {
            const customers = getAllCustomers();
            const dataStr = JSON.stringify(customers, null, 2);
            const dataUri = 'data:application/json;charset=utf-8,'+ encodeURIComponent(dataStr);
            
            const exportFileDefaultName = '客户数据_' + new Date().toISOString().split('T')[0] + '.json';
            
            const linkElement = document.createElement('a');
            linkElement.setAttribute('href', dataUri);
            linkElement.setAttribute('download', exportFileDefaultName);
            linkElement.click();
        }
        
        // 初始加载
        console.log('脚本加载完成，准备初始化...');
        window.onload =
HTML
