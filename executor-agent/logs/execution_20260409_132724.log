        th { background: #f1f5f9; font-weight: 600; }
        .status-valid { color: #10b981; font-weight: bold; }
        .status-expiring { color: #f59e0b; font-weight: bold; }
        .status-expired { color: #ef4444; font-weight: bold; }
        .modal { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); justify-content: center; align-items: center; }
        .modal.show { display: flex; }
        .modal-content { background: white; padding: 30px; border-radius: 10px; width: 90%; max-width: 900px; max-height: 85vh; overflow-y: auto; }
        .form-section { margin-bottom: 25px; padding-bottom: 20px; border-bottom: 2px solid #e2e8f0; }
        .section-title { font-size: 18px; font-weight: 600; margin-bottom: 15px; color: #1e293b; }
        .form-row { display: flex; gap: 20px; margin-bottom: 15px; }
        .form-group { flex: 1; }
        .form-label { display: block; margin-bottom: 8px; font-weight: 600; }
        .form-control { width: 100%; padding: 10px; border: 2px solid #e2e8f0; border-radius: 6px; }
