const fs = require('fs');
const path = require('path');

// 主应用文件路径
const appFilePath = '/opt/med-gsp-system/frontend/js/app.3b24beff.js';

// 读取文件内容
let content = fs.readFileSync(appFilePath, 'utf8');

// 查找导航菜单配置位置
// 查找 "产品信息" 和 "客户信息" 路由配置
const productRouteIndex = content.indexOf('{path:"/product",component:X,children:');
const customerRouteIndex = content.indexOf('{path:"/customer",component:X,children:');

if (productRouteIndex === -1 || customerRouteIndex === -1) {
    console.error('未找到产品或客户路由配置');
    process.exit(1);
}

console.log('✅ 找到产品管理路由配置');
console.log('✅ 找到客户管理路由配置');

