<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <title>菜单配置测试</title>
</head>
<body>
    <h2>菜单配置测试</h2>
    <div id="result">
        <h3>测试结果:</h3>
        <div id="test">测试中...</div>
    </div>
    <script>
        const test = document.getElementById('test');
        
        // 测试1: 检查主应用文件
        test.innerHTML += '<p>测试1: 检查主应用文件...</p>';
        fetch('/js/app.3b24beff.js')
            .then(response => response.text())
            .then(text => {
                // 检查路由配置
                const hasCustomerRoute = text.includes('/customer');
                const hasProductRoute = text.includes('/product');
                const hasCustomerMenu = text.includes('客户管理');
                const hasProductMenu = text.includes('产品管理');
                
                test.innerHTML += `<p>${hasCustomerRoute ? '✅' : '❌'} 找到/customer路由配置</p>`;
                test.innerHTML += `<p>${hasProductRoute ? '✅' : '❌'} 找到/product路由配置</p>`;
                test.innerHTML += `<p>${hasCustomerMenu ? '✅' : '❌'} 找到客户管理菜单</p>`;
                test.innerHTML += `<p>${hasProductMenu ? '✅' : '❌'} 找到产品管理菜单</p>`;
                
                // 显示路由配置片段
                if (hasCustomerRoute) {
                    const start = Math.max(0, text.indexOf('/customer') - 200);
                    const end = Math.min(text.length, text.indexOf('/customer') + 300);
                    test.innerHTML += '<p>路由配置片段:</p>';
                    test.innerHTML += `<pre style="background:#f5f5f5;padding:10px;overflow:auto;">${text.substring(start, end)}</pre>`;
                }
            })
            .catch(err => {
                test.innerHTML += '<p style="color:red;">❌ 无法读取主应用文件: ' + err.message + '</p>';
            });
        
        // 测试2: 测试路由访问
        setTimeout(() => {
            test.innerHTML += '<p>测试2: 测试路由访问...</p>';
            fetch('/customer')
                .then(response => {
                    test.innerHTML += `<p>${response.ok ? '✅' : '❌'} /customer路由可访问 (状态: ${response.status})</p>`;
                })
                .catch(err => {
                    test.innerHTML += '<p style="color:red;">❌ /customer路由访问失败: ' + err.message + '</p>';
                });
            
            fetch('/product')
                .then(response => {
                    test.innerHTML += `<p>${response.ok ? '✅' : '❌'} /product路由可访问 (状态: ${response.status})</p>`;
                })
                .catch(err => {
                    test.innerHTML += '<p style="color:red;">❌ /product路由访问失败: ' + err.message + '</p>';
                });
        }, 1000);
        
        // 测试3: 检查组件文件
        setTimeout(() => {
            test.innerHTML += '<p>测试3: 检查组件文件...</p>';
            fetch('/js/components/customerList.js')
                .then(response => {
                    test.innerHTML += `<p>${response.ok ? '✅' : '❌'} 客户管理组件文件可访问 (状态: ${response.status})</p>`;
                })
                .catch(err => {
                    test.innerHTML += '<p style="color:red;">❌ 客户管理组件文件访问失败: ' + err.message + '</p>';
                });
            
            fetch('/js/components/productList.js')
                .then(response => {
                    test.innerHTML += `<p>${response.ok ? '✅' : '❌'} 产品管理组件文件可访问 (状态: ${response.status})</p>`;
                })
                .catch(err => {
                    test.innerHTML += '<p style="color:red;">❌ 产品管理组件文件访问失败: ' + err.message + '</p>';
                });
        }, 2000);
        
        // 测试4: 检查主应用
        setTimeout(() => {
            test.innerHTML += '<p>测试4: 检查主应用...</p>';
            fetch('/')
                .then(response => {
                    test.innerHTML += `<p>${response.ok ? '✅' : '❌'} 主应用可访问 (状态: ${response.status})</p>`;
                })
                .catch(err => {
                    test.innerHTML += '<p style="color:red;">❌ 主应用访问失败: ' + err.message + '</p>';
                });
        }, 3000);
    </script>
</body>
</html>
