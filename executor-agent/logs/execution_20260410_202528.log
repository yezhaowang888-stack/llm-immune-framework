                                return response.json();
                            } else {
                                test.value += '<p style="color:red;">❌ 产品API不可访问 (状态: ' + response.status + ')</p>';
                                throw new Error('API不可访问');
                            }
                        })
                        .then(data => {
                            test.value += '<p style="color:green;">✅ 产品API返回数据: ' + (data.length || 0) + ' 条记录</p>';
                        })
                        .catch(err => {
                            test.value += '<p style="color:red;">❌ 产品API访问失败: ' + err.message + '</p>';
