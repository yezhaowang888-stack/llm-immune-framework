    <script>
        const { createApp, ref } = Vue;
        
        createApp({
            setup() {
                const test = ref('测试中...');
                
                // 测试1: 测试文件可访问性
                setTimeout(() => {
                    test.value += '<p>测试1: 测试文件可访问性...</p>';
                    
                    const files = [
