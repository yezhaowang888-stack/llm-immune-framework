                setTimeout(() => {
                    test.value += '<p>测试2: 测试组件导入...</p>';
                    
                    // 测试客户管理组件导入
                    import('/js/components/customerList.js')
                        .then(module => {
                            test.value += '<p style="color:green;">✅ 客户管理组件导入成功</p>';
                            
                            // 测试组件功能
                            if (module.default && module.default.name === 'CustomerList') {
                                test.value += '<p style="color:green;">✅ 客户管理组件名称正确</p>';
                            } else {
                                test.value += '<p style="color:orange;">⚠️ 客户管理组件名称不匹配</p>';
                            }
                        })
                        .catch(err => {
                            test.value += '<p style="color:red;">❌ 客户管理组件导入失败: ' + err.message + '</p>';
                        });
                    
                    // 测试产品管理组件导入
                    import('/js/components/productList.js')
                        .then(module => {
                            test.value += '<p style="color:green;">✅ 产品管理组件导入成功</p>';
                            
                            // 测试组件功能
                            if (module.default && module.default.name === 'ProductList') {
                                test.value += '<p style="color:green;">✅ 产品管理组件名称正确</p>';
                            } else {
                                test.value += '<p style="color:orange;">⚠️ 产品管理组件名称不匹配</p>';
                            }
                        })
                        .catch(err => {
                            test.value += '<p style="color:red;">❌ 产品管理组件导入失败: ' + err.message + '</p>';
                        });
                }, 3000);
                
                // 测试3: 测试路由访问
                setTimeout(() => {
                    test.value += '<p>测试3: 测试路由访问...</p>';
                    
                    const routes = [
                        { name: '首页', url: '/' },
                        { name: '客户管理', url: '/customer' },
                        { name: '产品管理', url: '/product' },
                        { name: '设备管理', url: '/device' },
                        { name: '库存管理', url: '/inventory' }
                    ];
                    
                    routes.forEach(route => {
                        fetch(route.url)
                            .then(response => {
                                if (response.ok) {
                                    test.value += `<p style="color:green;">✅ ${route.name}路由可访问 (状态: ${response.status})</p>`;
                                } else {
                                    test.value += `<p style="color:red;">❌ ${route.name}路由不可访问 (状态: ${response.status})</p>`;
                                }
                            })
                            .catch(err => {
                                test.value += `<p style="color:red;">❌ ${route.name}路由访问失败: ${err.message}</p>`;
                            });
                    });
                }, 6000);
                
                // 测试4: 测试API访问
                setTimeout(() => {
                    test.value += '<p>测试4: 测试API访问...</p>';
                    
                    fetch('/api/products')
