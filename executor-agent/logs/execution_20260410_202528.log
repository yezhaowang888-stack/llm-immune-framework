                        { name: '首页', url: '/' }
                    ];
                    
                    files.forEach(file => {
                        fetch(file.url)
                            .then(response => {
                                if (response.ok) {
                                    test.value += `<p style="color:green;">✅ ${file.name}可访问 (状态: ${response.status})</p>`;
                                } else {
