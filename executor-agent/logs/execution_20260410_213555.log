                    test2.innerHTML += '<p class="success">✅ 产品管理路由配置存在</p>';
                } else {
                    test2.innerHTML += '<p class="error">❌ 产品管理路由配置不存在</p>';
                }
                
                // 检查路由定义数量
                const customerCount = (text.match(/path.*customer/g) || []).length;
                const productCount = (text.match(/path.*product/g) || []).length;
                
                test2.innerHTML += '<p>客户路由定义数量: ' + customerCount + '</p>';
                test2.innerHTML += '<p>产品路由定义数量: ' + productCount + '</p>';
                
                if (customerCount === 1) {
                    test2.innerHTML += '<p class="success">✅ 客户路由定义正常 (无重复)</p>';
                } else {
                    test2.innerHTML += '<p class="error">❌ 客户路由定义异常</p>';
                }
                
                if (productCount === 1) {
                    test2.innerHTML += '<p class="success">✅ 产品路由定义正常 (无重复)</p>';
                } else {
                    test2.innerHTML += '<p class="error">❌ 产品路由定义异常</p>';
                }
                
                test2.innerHTML += '<p><strong>路由配置检查完成</strong></p>';
            })
            .catch(err => {
                test2.innerHTML += '<p class="error">❌ 路由配置检查失败: ' + err.message + '</p>';
            });
    </script>
</body>
</html>
