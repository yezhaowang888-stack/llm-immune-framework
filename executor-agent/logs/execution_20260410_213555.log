                test1.innerHTML += '<p>产品管理菜单项行: ' + (productIndex >= 0 ? productIndex : '未找到') + '</p>';
                
                if (customerIndex > inventoryIndex && customerIndex < reportIndex) {
                    test1.innerHTML += '<p class="success">✅ 客户管理菜单项位置正确（在库存管理和报表分析之间）</p>';
                } else if (customerIndex >= 0) {
                    test1.innerHTML += '<p class="warning">⚠️ 客户管理菜单项位置可能不正确</p>';
                }
                
                if (productIndex > inventoryIndex && productIndex < reportIndex) {
                    test1.innerHTML += '<p class="success">✅ 产品管理菜单项位置正确（在库存管理和报表分析之间）</p>';
                } else if (productIndex >= 0) {
                    test1.innerHTML += '<p class="warning">⚠️ 产品管理菜单项位置可能不正确</p>';
                }
                
                test1.innerHTML += '<p><strong>菜单项检查完成</strong></p>';
            })
            .catch(err => {
                test1.innerHTML += '<p class="error">❌ 菜单项检查失败: ' + err.message + '</p>';
            });
        
        // 测试2: 路由配置检查
        const test2 = document.getElementById('test2');
        fetch('/js/app.3b24beff.js')
