                    test2.innerHTML += '<p class="success">✅ 产品管理路由配置存在</p>';
                } else {
                    test2.innerHTML += '<p class="error">❌ 产品管理路由配置不存在</p>';
                }
                
                // 检查路由定义数量
                const customerCount = (text.match(/path.*customer/g) || []).length;
                const productCount = (text.match(/path.*product/g) || []).length;
                
