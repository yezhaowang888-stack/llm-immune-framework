// 最简单的Vue 3应用 - 修复编码问题
console.log('✅ 医疗器械管理系统启动...');

// 检查Vue是否已加载
if (typeof Vue === 'undefined') {
    console.error('❌ Vue.js未加载');
} else {
    console.log('✅ Vue.js已加载');
    
    // 创建最简单的Vue应用
    const app = Vue.createApp({
        data() {
            return {
                message: '医疗器械管理系统',
                user: null
            };
        },
        mounted() {
            console.log('✅ Vue应用已挂载');
            
            // 设置全局变量供动态路由系统使用
            window.vueApp = this;
            if (this.) {
                window. = this.;
                window.__VUE_ROUTER__ = this.;
                console.log('✅ Vue Router已设置');
            }
            
            // 加载用户信息
            this.loadUserInfo();
        },
        methods: {
            loadUserInfo() {
                try {
                    const userStr = localStorage.getItem('user');
                    if (userStr) {
                        this.user = JSON.parse(userStr);
                        console.log('✅ 用户信息加载:', this.user.username);
                    } else {
                        // 演示用户
                        this.user = {
                            id: 1,
                            username: '管理员',
                            role: 'ADMIN'
                        };
                        console.log('✅ 使用演示用户');
                    }
                } catch (error) {
                    console.error('❌ 加载用户信息失败:', error);
                }
            }
        },
        template: '<div id="app"><router-view /></div>'
    });
    
    // 创建简单的路由
    const routes = [
        { path: '/', component: { template: '<div><h2>首页</h2><p>医疗器械管理系统</p></div>' } },
        { path: '/dashboard', component: { template: '<div><h2>首页看板</h2><p>系统概览</p></div>' } },
        { path: '/customer', component: { template: '<div><h2>客户管理</h2><p>客户信息管理</p></div>' } },
        { path: '/product', component: { template: '<div><h2>产品管理</h2><p>产品信息管理</p></div>' } }
    ];
    
    // 创建路由实例
    const router = VueRouter.createRouter({
        history: VueRouter.createWebHistory(),
        routes
    });
    
    // 使用路由
    app.use(router);
    
    // 挂载应用
    app.mount('#app');
    
    console.log('✅ Vue应用创建完成');
}
EOF
