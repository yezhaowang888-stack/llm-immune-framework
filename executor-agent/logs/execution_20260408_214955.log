 <el-card>\r\n      <template #header>\r\n        <h3>新建销售订单</h3>\r\n      </template>\r\n      <el-form :model=\"form\" label-width=\"100px\">\r\n        <el-form-item label=\"客户名称\">\r\n          <el-input v-model=\"form.customer\" placeholder=\"请输入客户名称\" />\r\n        </el-form-item>\r\n        <el-form-item label=\"设备编码\">\r\n          <el-input v-model=\"form.deviceCode\" placeholder=\"请输入设备编码\" />\r\n        </el-form-item>\r\n        <el-form-item label=\"销售数量\">\r\n          <el-input-number v-model=\"form.quantity\" :min=\"1\" />\r\n        </el-form-item>\r\n        <el-form-item label=\"销售单价(万)\">\r\n          <el-input-number v-model=\"form.price\" :min=\"0\" :step=\"0.1\" />\r\n        </el-form-item>\r\n        <el-form-item>\r\n          <el-button type=\"primary\" @click=\"handleSave\">保存</el-button>\r\n          <el-button @click=\"router.back()\">返回</el-button>\r\n        </el-form-item>\r\n      </el-form>\r\n    </el-card>\r\n  </div>\r\n</template>\r\n\r\n<script setup>\r\nimport { reactive } from 'vue'\r\nimport { useRouter } from 'vue-router'\r\nimport { ElMessage } from 'element-plus'\r\nimport axios from 'axios'\r\n\r\nconst router = useRouter()\r\nconst form = reactive({\r\n  customer: '',\r\n  deviceCode: '',\r\n  quantity: 1,\r\n  price: 0\r\n})\r\n\r\nconst getAuthHeader = () => {\r\n  const userStr = localStorage.getItem('user')\r\n  if (userStr) {\r\n    try {\r\n      const user = JSON.parse(userStr)\r\n      if (user.token) {\r\n        return { Authorization: `Bearer ${user.token}` }\r\n      }\r\n    } catch (e) {}\r\n  }\r\n  return {}\r\n}\r\n\r\nconst handleSave = async () => {\r\n  if (!form.customer || !form.deviceCode) {\r\n    ElMessage.warning('请填写完整信息')\r\n    return\r\n  }\r\n  try {\r\n    await axios.post('/api/sales/orders', form, { headers: getAuthHeader() })\r\n    ElMessage.success('销售订单保存成功')\r\n    setTimeout(() => {\r\n      router.push('/sales')\r\n    }, 1500)\r\n  } catch (error) {\r\n    ElMessage.error('保存失败：' + (error.response?.data?.message || error.message))\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.sales-add {\r\n  padding: 20px;\r\n}\r\n</style>","import script from \"./add.vue?vue&type=script&setup=true&lang=js\"\nexport * from \"./add.vue?vue&type=script&setup=true&lang=js\"\n\nimport \"./add.vue?vue&type=style&index=0&id=4046a386&scoped=true&lang=css\"\n\nimport exportComponent from \"../../../node_modules/vue-loader/dist/exportHelper.js\"\nconst __exports__ = /*#__PURE__*/exportComponent(script, [['__scopeId',\"data-v-4046a386\"]])\n\nexport default __exports__"],"names":["router","useRouter","form","reactive","customer","deviceCode","quantity","price","getAuthHeader","userStr","localStorage","getItem","user","JSON","parse","token","Authorization","e","handleSave","async","axios","post","headers","ElMessage","success","setTimeout","push","error","response","data","message","warning","_createElementBlock","_hoisted_1","_createVNode","_component_el_card","header","_withCtx","_cache","_createElementVNode","_component_el_form","model","_component_el_form_item","label","_component_el_input","$event","placeholder","_component_el_input_number","min","step","_component_el_button","type","onClick","_unref","back","__exports__"],"sourceRoot":""}
