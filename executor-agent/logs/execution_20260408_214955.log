ss=\"company-name\">山东惠迈生物科技有限公司</h2>\r\n        <p class=\"system-name\">医疗器械管理系统 v1.0</p>\r\n      </div>\r\n\r\n      <!-- 登录表单 -->\r\n      <el-form \r\n        ref=\"formRef\"\r\n        :model=\"form\"\r\n        :rules=\"rules\"\r\n        class=\"login-form\"\r\n        @keyup.enter=\"handleLogin\"\r\n      >\r\n        <!-- 用户名 -->\r\n        <el-form-item prop=\"username\">\r\n          <el-input\r\n            v-model=\"form.username\"\r\n            placeholder=\"工号/手机号/邮箱\"\r\n            :prefix-icon=\"User\"\r\n            size=\"large\"\r\n            clearable\r\n          />\r\n          <div class=\"input-hint\">📝 工号/手机号/邮箱</div>\r\n        </el-form-item>\r\n\r\n        <!-- 密码 -->\r\n        <el-form-item prop=\"password\">\r\n          <el-input\r\n            v-model=\"form.password\"\r\n            type=\"password\"\r\n            placeholder=\"密码\"\r\n            :prefix-icon=\"Lock\"\r\n            size=\"large\"\r\n            show-password\r\n            clearable\r\n          />\r\n          <div class=\"input-hint\">🔒 6-20位字符，区分大小写</div>\r\n        </el-form-item>\r\n\r\n        <!-- 记住密码和忘记密码 -->\r\n        <div class=\"form-options\">\r\n          <el-checkbox v-model=\"form.remember\">记住密码</el-checkbox>\r\n          <el-link type=\"primary\" :underline=\"false\">忘记密码？</el-link>\r\n        </div>\r\n\r\n        <!-- 登录按钮 -->\r\n        <el-button\r\n          type=\"primary\"\r\n          size=\"large\"\r\n          :loading=\"loading\"\r\n          class=\"login-button\"\r\n          @click=\"handleLogin\"\r\n        >\r\n          {{ loading ? '登录中...' : '登录' }}\r\n        </el-button>\r\n\r\n        <!-- 其他登录方式 -->\r\n        <div class=\"other-login\">\r\n          <span class=\"other-login-text\">其他登录方式：</span>\r\n          <el-button text>📱 验证码登录</el-button>\r\n          <el-button text>👤 扫码登录</el-button>\r\n        </div>\r\n      </el-form>\r\n\r\n      <!-- 版权信息 -->\r\n      <div class=\"login-footer\">\r\n        <p>© 2026 山东惠迈生物科技有限公司</p>\r\n        <p>版本号: v1.0.0</p>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script setup>\r\nimport { ref, reactive } from 'vue'\r\nimport { useRouter } from 'vue-router'\r\nimport { ElMessage } from 'element-plus'\r\nimport { User, Lock } from '@element-plus/icons-vue'\r\nimport axios from 'axios'\r\n\r\nconst router = useRouter()\r\nconst formRef = ref(null)\r\nconst loading = ref(false)\r\n\r\nconst form = reactive({\r\n  username: '',\r\n  password: '',\r\n  remember: false\r\n})\r\n\r\nconst rules = {\r\n  username: [\r\n    { required: true, message: '请输入用户名', trigger: 'blur' },\r\n    { min: 3, max: 20, message: '长度在 3 到 20 个字符', trigger: 'blur' }\r\n  ],\r\n  password: [\r\n    { required: true, message: '请输入密码', trigger: 'blur' },\r\n    { min: 6, max: 20, message: '长度在 6 到 20 个字符', trigger: 'blur' }\r\n  ]\r\n}\r\n\r\nconst handleLogin = async () => {\r\n  if (!formRef.value) return\r\n  \r\n  await formRef.value.validate(async (valid) => {\r\n    if (valid) {\r\n      loading.value = true\r\n      try {\r\n        // 调用后端登录接口\r\n        const res = await axios.post('/api/users/login', {\r\n          username: form.username,\r\n          password: form.password\r\n        })\r\n        \r\n        if (res.data.success) {\r\n          // 保存用户信息到 localStorage\r\n          const userInfo = {\r\n            id: res.data.id,\r\n            username: res.data.username,\r\n            realName: res.data.realName,\r\n            role: res.data.role,\r\n            token: res.data.token\r\n          }\r\n          localStorage.setItem('user', JSON.stringify(userInfo))\r\n          \r\n          ElMessage.success(res.data.message)\r\n          router.push('/dashboard')\r\n        } else {\r\n          ElMessage.error(res.data.message)\r\n        }\r\n      } catch (error) {\r\n        console.error('登录失败:', error)\r\n        ElMessage.error('登录失败：' + (error.response?.data?.message || error.message))\r\n      } finally {\r\n        loading.value = false\r\n      }\r\n    }\r\n  })\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.login-container {\r\n  min-height: 100vh;\r\n  display: flex;\r\n  justify-content: center;\r\n  align-items: center;\r\n  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\r\n}\r\n\r\n.login-box {\r\n  width: 420px;\r\n  padding: 40px;\r\n  background: white;\r\n  border-radius: 8px;\r\n  box-shadow: 0 2px 12px 0 rgba(0, 0, 0, 0.1);\r\n}\r\n\r\n.login-header {\r\n  text-align: center;\r\n  margin-bottom: 30px;\r\n}\r\n\r\n.logo {\r\n  width: 80px;\r\n  height: auto;\r\n  margin-bottom: 10px;\r\n}\r\n\r\n.company-name {\r\n  font-size: 18px;\r\n  font-weight: 600;\r\n  color: #333;\r\n  margin: 0 0 5px;\r\n}\r\n\r\n.system-name {\r\n  font-size: 14px;\r\n  color: #666;\r\n  margin: 0;\r\n}\r\n\r\n.input-hint {\r\n  font-size: 12px;\r\n  color: #999;\r\n  margin-top: 4px;\r\n  padding-left: 4px;\r\n}\r\n\r\n.form-options {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  margin: 10px 0 20px;\r\n}\r\n\r\n.login-button {\r\n  width: 100%;\r\n  height: 44px;\r\n  font-size: 16px;\r\n  margin-bottom: 20px;\r\n}\r\n\r\n.other-login {\r\n  display: flex;\r\n  justify-content: center;\r\n  align-items: center;\r\n  gap: 15px;\r\n  font-size: 14px;\r\n}\r\n\r\n.other-login-text {\r\n  color: #666;\r\n}\r\n\r\n.login-footer {\r\n  margin-top: 30px;\r\n  text-align: center;\r\n  font-size: 12px;\r\n  color: #999;\r\n}\r\n\r\n.login-footer p {\r\n  margin: 2px 0;\r\n}\r\n</style>","import script from \"./Home.vue?vue&type=script&setup=true&lang=js\"\nexport * from \"./Home.vue?vue&type=script&setup=true&lang=js\"\n\nimport \"./Home.vue?vue&type=style&index=0&id=f359c5a4&scoped=true&lang=css\"\n\nimport exportComponent from \"../../node_modules/vue-loader/dist/exportHelper.js\"\nconst __exports__ = /*#__PURE__*/exportComponent(script, [['__scopeId',\"data-v-f359c5a4\"]])\n\nexport default __exports__","<template>\r\n  <div class=\"app-wrapper\">\r\n    <!-- 侧边栏 -->\r\n    <div class=\"sidebar\" :class=\"{ collapsed: isCollapsed }\">\r\n      <div class=\"logo-container\">\r\n        <img src=\"@/assets/logo.png\" alt=\"Logo\" class=\"logo\">\r\n        <span v-if=\"!isCollapsed\" class=\"logo-text\">惠迈医疗</span>\r\n      </div>\r\n      \r\n      <el-menu\r\n        :default-active=\"activeMenu\"\r\n        class=\"sidebar-menu\"\r\n        :collapse=\"isCollapsed\"\r\n        :collapse-transition=\"false\"\r\n        router\r\n      >\r\n        <el-menu-item index=\"/dashboard\">\r\n          <el-icon><Odometer /></el-icon>\r\n          <span>首页看板</span>\r\n        </el-menu-item>\r\n        \r\n        <!-- 设备档案 -->\r\n        <el-sub-menu index=\"device\">\r\n          <template #title>\r\n            <el-icon><Monitor /></el-icon>\r\n            <span>设备档案</span>\r\n          </template>\r\n          <el-menu-item index=\"/device\">设备列表</el-menu-item>\r\n          <el-menu-item index=\"/device/instock\">设备入库</el-menu-item>\r\n          <el-menu-item index=\"/device/outstock\">设备出库</el-menu-item>\r\n        </el-sub-menu>\r\n        \r\n        <!-- 销售订单 -->\r\n        <el-sub-menu index=\"sales\">\r\n          <template #title>\r\n            <el-icon><ShoppingCart /></el-icon>\r\n            <span>销售订单</span>\r\n          </template>\r\n          <el-menu-item index=\"/sales\">订单列表</el-menu-item>\r\n          <!-- add.vue 文件不存在，暂时注释 -->\r\n          <!-- <el-menu-item index=\"/sales/add\">新建订单</el-menu-item> -->\r\n        </el-sub-menu>\r\n        \r\n        <!-- 采购入库 -->\r\n        <el-sub-menu index=\"purchase\">\r\n          <template #title>\r\n            <el-icon><Box /></el-icon>\r\n            <span>采购入库</span>\r\n          </template>\r\n          <el-menu-item index=\"/purchase\">采购列表</el-menu-item>\r\n          <el-menu-item index=\"/purchase/add\">新建采购</el-menu-item>\r\n          <el-menu-item index=\"/purchase/scan\">扫码入库</el-menu-item>\r\n        </el-sub-menu>\r\n        \r\n        <!-- 售后维修 -->\r\n        <el-sub-menu index=\"after-sales\">\r\n          <template #title>\r\n            <el-icon><Tools /></el-icon>\r\n            <span>售后维修</span>\r\n          </template>\r\n          <el-menu-item index=\"/after-sales\">工单列表</el-menu-item>\r\n          <el-menu-item index=\"/after-sales/add\">新建工单</el-menu-item>\r\n        </el-sub-menu>\r\n        \r\n        <!-- 库存管理 -->\r\n        <el-sub-menu index=\"inventory\">\r\n          <template #title>\r\n            <el-icon><Files /></el-icon>\r\n            <span>库存管理</span>\r\n          </template>\r\n          <el-menu-item index=\"/inventory\">库存列表</el-menu-item>\r\n          <el-menu-item index=\"/inventory/check\">库存盘点</el-menu-item>\r\n          <el-menu-item index=\"/inventory/move\">库位转移</el-menu-item>\r\n        </el-sub-menu>\r\n        \r\n        <el-menu-item index=\"/report\">\r\n          <el-icon><DataLine /></el-icon>\r\n          <span>报表分析</span>\r\n        </el-menu-item>\r\n        \r\n        <!-- 只有管理员能看到系统设置 -->\r\n        <el-menu-item index=\"/system\" v-if=\"userRole === 'ADMIN'\">\r\n          <el-icon><Setting /></el-icon>\r\n          <span>系统设置</span>\r\n        </el-menu-item>\r\n      </el-menu>\r\n      \r\n      <div class=\"collapse-btn\" @click=\"toggleSidebar\">\r\n        <el-icon>\r\n          <component :is=\"isCollapsed ? 'Expand' : 'Fold'\" />\r\n        </el-icon>\r\n      </div>\r\n    </div>\r\n    \r\n    <!-- 主内容区保持不变 -->\r\n    <div class=\"main-container\" :class=\"{ collapsed: isCollapsed }\">\r\n      <div class=\"header\">\r\n        <div class=\"header-left\">\r\n          <el-breadcrumb separator=\"/\">\r\n            <el-breadcrumb-item :to=\"{ path: '/dashboard' }\">首页</el-breadcrumb-item>\r\n            <el-breadcrumb-item>{{ currentRoute }}</el-breadcrumb-item>\r\n          </el-breadcrumb>\r\n        </div>\r\n        \r\n        <div class=\"header-right\">\r\n          <el-badge :value=\"3\" class=\"notification-badge\">\r\