    <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
    <script src="https://unpkg.com/vue-router@4"></script>
    <script src="/js/vue-wrapper.js"></script>
</head>
<body>
    <h1>最终修复测试</h1>
    <div id="test-app"></div>
    
    <script>
        console.log('🧪 最终修复测试开始...');
        
        // 测试Vue加载
        if (typeof Vue !== 'undefined') {
            console.log('✅ Vue.js已加载');
            
            // 创建简单的Vue应用
            const app = Vue.createApp({
                data() {
                    return {
                        message: '医疗器械管理系统测试'
                    };
                },
                template: '<div>{{ message }}</div>'
            });
            
            // 创建路由
            const router = VueRouter.createRouter({
                history: VueRouter.createWebHistory(),
                routes: [
                    { path: '/', component: { template: '<div>首页</div>' } }
                ]
            });
            
            app.use(router);
            app.mount('#test-app');
            
            console.log('✅ Vue应用创建成功');
            console.log('✅ Vue Router创建成功');
            
            // 设置全局变量
            window.__VUE_LOADED__ = true;
            window.__VUE_ROUTER_LOADED__ = true;
            window. = router;
            window.__VUE_ROUTER__ = router;
            
            console.log('✅ 全局变量已设置');
        } else {
            console.error('❌ Vue.js未加载');
        }
        
        console.log('🧪 最终修复测试完成');
    </script>
</body>
</html>
EOF
