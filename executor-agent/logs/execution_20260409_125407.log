    qualification_number VARCHAR(100) COMMENT "资质编号",
    qualification_issue_date DATE COMMENT "发证日期",
    qualification_expiry_date DATE COMMENT "到期日期",
    qualification_status VARCHAR(50) DEFAULT "有效" COMMENT "资质状态",
    
    -- 预警设置
    warning_days INT DEFAULT 30 COMMENT "预警天数",
    
    -- 系统字段
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    is_deleted TINYINT DEFAULT 0 COMMENT "软删除标记",
    notes TEXT COMMENT "备注"
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COMMENT="客户信息表";

SHOW TABLES;
