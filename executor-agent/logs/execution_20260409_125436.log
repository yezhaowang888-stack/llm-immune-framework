package com.medgsp.customer;

import org.springframework.web.bind.annotation.*;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.http.ResponseEntity;
import java.util.List;
import java.util.Map;
import java.util.HashMap;

@RestController
@RequestMapping("/api/customers")
public class CustomerController {
    
    // 临时内存存储（今天先用，明天改数据库）
    private Map<Long, Customer> customerStore = new HashMap<>();
    private Long nextId = 1L;
    
    @GetMapping
    public List<Customer> getAllCustomers() {
        return List.copyOf(customerStore.values());
    }
    
    @GetMapping("/{id}")
    public ResponseEntity<Customer> getCustomer(@PathVariable Long id) {
        Customer customer = customerStore.get(id);
        if (customer == null) {
            return ResponseEntity.notFound().build();
        }
        return ResponseEntity.ok(customer);
    }
    
    @PostMapping
    public Customer createCustomer(@RequestBody Customer customer) {
        customer.setId(nextId++);
        customerStore.put(customer.getId(), customer);
        return customer;
    }
    
    @PutMapping("/{id}")
    public ResponseEntity<Customer> updateCustomer(@PathVariable Long id, @RequestBody Customer customer) {
        if (!customerStore.containsKey(id)) {
            return ResponseEntity.notFound().build();
        }
        customer.setId(id);
        customerStore.put(id, customer);
        return ResponseEntity.ok(customer);
    }
    
    @DeleteMapping("/{id}")
    public ResponseEntity<Void> deleteCustomer(@PathVariable Long id) {
        if (!customerStore.containsKey(id)) {
            return ResponseEntity.notFound().build();
        }
        customerStore.remove(id);
        return ResponseEntity.noContent().build();
    }
    
    @GetMapping("/expiring")
    public List<Customer> getExpiringCustomers() {
        // 模拟即将到期的客户（今天先用模拟数据）
        return customerStore.values().stream()
            .filter(c -> c.getQualificationExpiryDate() != null)
            .limit(5)
            .toList();
    }
}

