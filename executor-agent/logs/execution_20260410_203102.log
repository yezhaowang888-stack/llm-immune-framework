</head>
<body>
    <h2>系统状态检查</h2>
    <div id="status">检查中...</div>
    
    <script>
        const status = document.getElementById('status');
        const tests = [
            { name: 'Nginx服务', url: '/' },
            { name: '主应用文件', url: '/js/app.3b24beff.js' },
            { name: '客户管理组件', url: '/js/components/customerList.js' },
            { name: '产品管理组件', url: '/js/components/productList.js' },
            { name: 'CSS文件', url: '/css/medical-management.css' },
            { name: '客户管理路由', url: '/customer' },
            { name: '产品管理路由', url: '/product' },
            { name: '产品API', url: '/api/products' }
        ];
        
        let completed = 0;
        
        tests.forEach(test => {
            fetch(test.url)
                .then(response => {
                    completed++;
                    if (response.ok) {
                        status.innerHTML += `<p style="color:green;">✅ ${test.name}可访问 (状态: ${response.status})</p>`;
                    } else {
                        status.innerHTML += `<p style="color:orange;">⚠️ ${test.name}不可访问 (状态: ${response.status})</p>`;
                    }
                    
                    // 所有测试完成后显示总结
                    if (completed === tests.length) {
                        status.innerHTML += '<hr><h3>系统状态总结</h3>';
                        status.innerHTML += '<p>Nginx修复已完成，文件可访问性问题已解决。</p>';
                        status.innerHTML += '<p>下一步：修复主应用JavaScript文件中的导入语法。</p>';
                    }
                })
                .catch(err => {
                    completed++;
                    status.innerHTML += `<p style="color:red;">❌ ${test.name}访问失败: ${err.message}</p>`;
                    
                    if (completed === tests.length) {
                        status.innerHTML += '<hr><h3>系统状态总结</h3>';
                        status.innerHTML += '<p>仍有访问问题，需要进一步诊断。</p>';
                    }
                });
        });
    </script>
</body>
</html>
