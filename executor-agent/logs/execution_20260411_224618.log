                                </div>
                            </div>
                        `
                    };
                })
            });
            console.log('✅ 客户管理路由已注册（真实组件）');
        }
        
        // 产品管理路由 - 使用真实组件
        if (!routerHasRoute(router, '/product')) {
            router.addRoute({
                path: '/product',
                name: 'product',
                component: () => Promise.resolve().then(() => {
                    return {
                        template: `
                            <div style="padding: 20px;">
                                <h2>产品信息管理</h2>
                                <div style="margin: 20px 0; padding: 20px; background: #f0f9ff; border-radius: 8px;">
